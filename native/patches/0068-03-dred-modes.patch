+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum DredMode {
+    Off,
+    PageFaults,
+    Breadcrumbs,
+}
+
+// Recovery's explicit sub-flag wins over the legacy diagnostics flag: setting
+// VICTORY_D3D12_DRED must not silently enable per-command work during recovery.
+fn dred_policy(recovery: bool, recovery_breadcrumbs: bool, diagnostics_dred: bool) -> DredMode {
+    if recovery {
+        if recovery_breadcrumbs {
+            DredMode::Breadcrumbs
+        } else {
+            DredMode::PageFaults
+        }
+    } else if diagnostics_dred {
+        DredMode::Breadcrumbs
+    } else {
+        DredMode::Off
+    }
+}
+
+fn dred_mode() -> DredMode {
+    static MODE: OnceLock<DredMode> = OnceLock::new();
+    *MODE.get_or_init(|| {
+        dred_policy(
+            crate::removal::enabled(),
+            std::env::var_os("VICTORY_RECOVER_REMOVAL_BREADCRUMBS").is_some_and(|v| v == "1"),
+            cfg!(feature = "diagnostics") && std::env::var_os("VICTORY_D3D12_DRED").is_some(),
+        )
     })
 }
 
+/// Recovery uses page-fault data by default. This retains object lifetime and
+/// naming costs, but no AutoBreadcrumbs or our per-command diagnostic markers.
+pub(crate) fn dred_on() -> bool {
+    dred_mode() != DredMode::Off
+}
+
+fn dred_breadcrumbs_on() -> bool {
+    dred_mode() == DredMode::Breadcrumbs
+}
