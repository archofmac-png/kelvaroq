+//! Every committed seed is generated here, without external/title data.
+pub type Seed = (&'static str, &'static str, Vec<u8>, bool);
+fn word(bytes: &mut [u8], at: usize, value: u32) {
+    bytes[at..at + 4].copy_from_slice(&value.to_le_bytes());
+}
+fn hex(s: &str) -> Vec<u8> {
+    s.as_bytes()
+        .chunks_exact(2)
+        .map(|pair| {
+            let digit = |b: u8| if b <= b'9' { b - b'0' } else { b - b'a' + 10 };
+            digit(pair[0]) * 16 + digit(pair[1])
+        })
+        .collect()
+}
+
+pub fn all() -> Vec<Seed> {
+    let mut seeds = Vec::new();
+    let mut rpf = vec![0; 24];
+    rpf[..4].copy_from_slice(b"9FPR");
+    word(&mut rpf, 4, 24);
+    word(&mut rpf, 8, 20);
+    seeds.push(("rpf9", "split.seed", rpf.clone(), true));
+    let mut empty = rpf[..16].to_vec();
+    word(&mut empty, 4, 16);
+    word(&mut empty, 8, 16);
+    seeds.push(("rpf9", "empty.seed", empty, true));
+    seeds.push(("rpf9", "truncated.seed", rpf[..15].to_vec(), false));
+    word(&mut rpf, 8, 25);
+    seeds.push(("rpf9", "reversed.seed", rpf.clone(), false));
+    word(&mut rpf, 8, 16);
+    word(&mut rpf, 4, u32::MAX);
+    seeds.push(("rpf9", "oversize.seed", rpf, false));
+
+    let mut shader = vec![0; 48];
+    shader[..4].copy_from_slice(b"DXBC");
+    word(&mut shader, 20, 1);
+    word(&mut shader, 24, 48);
+    word(&mut shader, 28, 1);
+    word(&mut shader, 32, 36);
+    shader[36..40].copy_from_slice(b"SFI0");
+    word(&mut shader, 40, 4);
+    seeds.push(("shader_header", "one-part.seed", shader.clone(), true));
+    let mut empty = shader[..32].to_vec();
+    word(&mut empty, 24, 32);
+    word(&mut empty, 28, 0);
+    seeds.push(("shader_header", "empty.seed", empty, true));
+    let mut short = shader[..32].to_vec();
+    word(&mut short, 24, 32);
+    seeds.push(("shader_header", "short-table.seed", short, false));
+    let mut bad = shader.clone();
+    word(&mut bad, 32, 0);
+    seeds.push(("shader_header", "header-overlap.seed", bad, false));
+    let mut bad = shader.clone();
+    word(&mut bad, 32, u32::MAX);
+    seeds.push(("shader_header", "offset.seed", bad, false));
+    let mut bad = shader.clone();
+    word(&mut bad, 40, u32::MAX);
+    seeds.push(("shader_header", "size.seed", bad, false));
+    word(&mut shader, 28, u32::MAX);
+    seeds.push(("shader_header", "count.seed", shader, false));
+    let mut packed = vec![1, 1, 0];
+    packed.extend(hex(concat!(
+        "000000000000000004040303030303030101204020204020010104100404100400000000000000000202051105051105",
+        "000000000000000000000000000001010101010101010000000000000000000004040404010101010101010100000000",
+        "0202020200000000",
+    )));
+    seeds.push(("bcpack", "bc1.seed", packed, true));
+    let mut packed = vec![3, 1, 0];
+    packed.extend(hex(concat!(
+        "000000000000000004040504040404040101011010101004000002080808080102020000000000000101030909090902",
+        "020202111111110500000000040405051004010108010202000000000902030311050202000000",
+    )));
+    seeds.push(("bcpack", "bc3.seed", packed, true));
+    let mut packed = vec![4, 1, 0];
+    packed.extend(hex(concat!(
+        "000000000000000004040404030303030101010140404040010101011010101000000000000000000202020211111111",
+        "000000000000000000000000000000000101010101010101000000000000000000000000030303034040404010101010",
+        "0000000011111111",
+    )));
+    seeds.push(("bcpack", "bc4.seed", packed, true));
+    let mut packed = vec![5, 1, 0];
+    packed.extend(hex(concat!(
+        "000000000000000004040505040404040101010110101010000002020808080802020000000000000101030309090909",
+        "0202020211111111000000000404040410101010080808080000000009090909111111110000",
+    )));
+    seeds.push(("bcpack", "bc5.seed", packed, true));
+    let mut packed = vec![6, 1, 0];
+    packed.extend(hex(concat!(
+        "000000000000000004040505050404040101010101040404000002020201010102020000000000000101030303020202",
+        "020202020205050500000000000000000404040505050504101010010101010408080802020202000000000000000054",
+        "0909090303030300111111020202020500000000000000",
+    )));
+    seeds.push(("bcpack", "bc6.seed", packed, true));
+    let mut packed = vec![7, 1, 0];
+    packed.extend(hex(concat!(
+        "000000000000000004040505050505040101010101010140000002020202024002020000000000000101030303030341",
+        "020202020202024100000000000000000404040505050504400410010101010440010802020202010000000000000000",
+        "410209030303030241051102020202050000000000000000000000000000000001010101010101010000000000000000",
+        "00000000000000000101010000000000",
+    )));
+    seeds.push(("bcpack", "bc7.seed", packed, true));
+    seeds.push(("bcpack", "truncated.seed", vec![1, 1, 0, 0], false));
+    seeds.push(("bcpack", "format.seed", vec![2, 1, 0], false));
+    seeds.push(("bcpack", "output-limit.seed", vec![1, 255, 255], false));
+    // PE fixtures are appended below.
+    pe_seeds(&mut seeds);
+    seeds
+}
+
+// One tiny PE32+ section, with synthetic named+ordinal imports, export, and delay import.
+fn pe_image() -> Vec<u8> {
+    let mut d = vec![0; 0x400];
+    d[..2].copy_from_slice(b"MZ");
+    word(&mut d, 0x3c, 0x40);
+    d[0x40..0x44].copy_from_slice(b"PE\0\0");
+    d[0x44..0x46].copy_from_slice(&0x8664u16.to_le_bytes());
+    d[0x46..0x48].copy_from_slice(&1u16.to_le_bytes());
+    d[0x54..0x56].copy_from_slice(&240u16.to_le_bytes());
+    d[0x56..0x58].copy_from_slice(&0x2022u16.to_le_bytes());
+    let opt = 0x58;
+    d[opt..opt + 2].copy_from_slice(&0x20bu16.to_le_bytes());
+    d[opt + 24..opt + 32].copy_from_slice(&0x1_8000_0000u64.to_le_bytes());
+    for (at, val) in [
+        (32, 0x1000),
+        (36, 0x200),
+        (56, 0x2000),
+        (60, 0x200),
+        (108, 16),
+        (112, 0x1000),
+        (116, 0x80),
+        (120, 0x1080),
+        (124, 40),
+        (216, 0x1100),
+        (220, 64),
+    ] {
+        word(&mut d, opt + at, val);
+    }
+    let sec = opt + 240;
+    d[sec..sec + 6].copy_from_slice(b".edata");
+    for (at, val) in [(8, 0x200), (12, 0x1000), (16, 0x200), (20, 0x200)] {
+        word(&mut d, sec + at, val);
+    }
+    let body = 0x200;
+    for (at, val) in [
+        (16, 1),
+        (20, 1),
+        (24, 1),
+        (28, 0x1028),
+        (32, 0x102c),
+        (36, 0x1030),
+        (0x28, 0x1200),
+        (0x2c, 0x1040),
+        (0x80, 0x10c0),
+        (0x8c, 0x10b0),
+        (0x90, 0x1160),
+        (0x100, 1),
+        (0x104, 0x10b0),
+        (0x10c, 0x1160),
+        (0x110, 0x10c0),
+    ] {
+        word(&mut d, body + at, val);
+    }
+    d[body + 0x40..body + 0x47].copy_from_slice(b"export\0");
+    d[body + 0xb0..body + 0xb9].copy_from_slice(b"seed.dll\0");
+    for at in [0xc0, 0x160] {
+        d[body + at..body + at + 8].copy_from_slice(&0x10e0u64.to_le_bytes());
+        d[body + at + 8..body + at + 16].copy_from_slice(&0x8000_0000_0000_0007u64.to_le_bytes());
+    }
+    d[body + 0xe0..body + 0xe2].copy_from_slice(&7u16.to_le_bytes());
+    d[body + 0xe2..body + 0xe7].copy_from_slice(b"seed\0");
+    d
+}
+
+fn pe_seeds(seeds: &mut Vec<Seed>) {
+    let pe = pe_image();
+    let mut alias = pe.clone();
+    word(&mut alias, 0x218, 2);
+    word(&mut alias, 0x220, 0x1050);
+    word(&mut alias, 0x224, 0x1058);
+    word(&mut alias, 0x250, 0x1040);
+    word(&mut alias, 0x254, 0x1048);
+    alias[0x248..0x24e].copy_from_slice(b"alias\0");
+    seeds.push(("pe", "aliases.seed", alias, true));
+    let mut forward = pe.clone();
+    word(&mut forward, 0x228, 0x1048);
+    forward[0x248..0x251].copy_from_slice(b"other.#7\0");
+    seeds.push(("pe", "forward.seed", forward.clone(), true));
+    // Claimed export directory ends before this forward string's NUL.
