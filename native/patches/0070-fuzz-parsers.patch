+//! Bounded PE32+ table walks. File offsets accompany every rejected read.
+//! Layout: https://learn.microsoft.com/en-us/windows/win32/debug/pe-format
+use super::*;
+
+pub(super) const MAX_SECTIONS: usize = 1024;
+const MAX_MODULES: usize = 4096;
+const MAX_ENTRIES: usize = 65_536;
+const MAX_STRING: usize = 4096;
+const MAX_OUTPUT: usize = 16 * 1024 * 1024;
+
+pub(super) struct Walker<'a, 'f> {
+    data: &'a [u8],
+    sections: &'f [SectionInfo],
+    file: &'f PeFile64<'a>,
+    image_size: u32,
+    output: usize,
+    entries: usize,
+}
+
+impl<'a, 'f> Walker<'a, 'f> {
+    pub(super) fn new(
+        data: &'a [u8],
+        sections: &'f [SectionInfo],
+        file: &'f PeFile64<'a>,
+        image_size: u32,
+    ) -> Self {
+        Self {
+            data,
+            sections,
+            file,
+            image_size,
+            output: 0,
+            entries: 0,
+        }
+    }
+
+    fn charge(&mut self, n: usize, at: usize) -> Result<(), PeError> {
+        self.output = self
+            .output
+            .checked_add(n)
+            .filter(|&n| n <= MAX_OUTPUT)
+            .ok_or_else(|| PeError::at(at, "parsed output exceeds 16 MiB limit"))?;
+        Ok(())
+    }
+
+    fn span(&self, rva: u32, size: usize, field: usize) -> Result<(usize, &'a [u8]), PeError> {
+        for s in self.sections {
+            let Some(delta) = rva.checked_sub(s.rva) else {
+                continue;
+            };
+            let backed = if s.virtual_size == 0 {
+                s.file_size
+            } else {
+                s.file_size.min(s.virtual_size)
+            };
+            if delta >= backed {
+                continue;
+            }
+            let at = (s.file_offset as usize)
+                .checked_add(delta as usize)
+                .ok_or_else(|| PeError::at(field, "file offset overflow"))?;
+            let remaining = (backed - delta) as usize;
+            if size > remaining {
+                return Err(PeError::at(at, "read crosses section boundary"));
+            }
+            let end = at
+                .checked_add(size)
+                .ok_or_else(|| PeError::at(at, "read length overflow"))?;
+            return self
+                .data
+                .get(at..end)
+                .map(|b| (at, b))
+                .ok_or_else(|| PeError::at(at, "read extends past file"));
+        }
+        Err(PeError::at(
+            field,
+            format!("RVA {rva:#x} is not file-backed"),
+        ))
+    }
+
+    fn add(rva: u32, n: usize, at: usize) -> Result<u32, PeError> {
+        u32::try_from(n)
+            .ok()
+            .and_then(|n| rva.checked_add(n))
+            .ok_or_else(|| PeError::at(at, "RVA arithmetic overflow"))
+    }
+
+    fn u32(&self, rva: u32, field: usize) -> Result<(usize, u32), PeError> {
+        let (at, b) = self.span(rva, 4, field)?;
+        Ok((
+            at,
+            u32::from_le_bytes(b.try_into().expect("checked 4-byte span")),
+        ))
+    }
+
+    fn u64(&self, rva: u32, field: usize) -> Result<(usize, u64), PeError> {
+        let (at, b) = self.span(rva, 8, field)?;
+        Ok((
+            at,
+            u64::from_le_bytes(b.try_into().expect("checked 8-byte span")),
+        ))
+    }
+
+    pub(super) fn directory_offset(&self, index: usize) -> usize {
+        layout::data_directory_offset(self.data, index).unwrap_or(0)
+    }
+
+    fn directory(&self, index: usize) -> Option<(u32, u32, usize)> {
+        let d = self.file.data_directory(index)?;
+        let rva = d.virtual_address.get(LE);
+        (rva != 0).then(|| (rva, d.size.get(LE), self.directory_offset(index)))
+    }
+
+    pub(super) fn string_bytes(&mut self, bytes: &[u8], at: usize) -> Result<String, PeError> {
+        if bytes.len() > MAX_STRING {
+            return Err(PeError::at(at, "string exceeds 4096-byte limit"));
+        }
+        self.charge(bytes.len() * 3, at)?;
+        Ok(String::from_utf8_lossy(bytes).into_owned())
+    }
+
+    fn string(&mut self, rva: u32, field: usize) -> Result<String, PeError> {
+        self.string_limit(rva, field, MAX_STRING)
+    }
+
+    fn string_limit(&mut self, rva: u32, field: usize, limit: usize) -> Result<String, PeError> {
+        let (at, _) = self.span(rva, 1, field)?;
+        let section_end = self
+            .sections
+            .iter()
+            .find_map(|s| {
+                let delta = rva.checked_sub(s.rva)?;
+                let backed = if s.virtual_size == 0 {
+                    s.file_size
+                } else {
+                    s.file_size.min(s.virtual_size)
+                };
+                (delta < backed).then(|| at + (backed - delta) as usize)
+            })
+            .ok_or_else(|| PeError::at(field, "string is not file-backed"))?;
+        let end = section_end.min(at.saturating_add(limit.min(MAX_STRING) + 1));
+        let tail = self
+            .data
+            .get(at..end)
+            .ok_or_else(|| PeError::at(at, "string extends past file"))?;
+        let n = tail
+            .iter()
+            .position(|&b| b == 0)
+            .ok_or_else(|| PeError::at(at, "unterminated or oversized string"))?;
+        self.string_bytes(&tail[..n], at)
+    }
+
+    pub(super) fn imports(&mut self, delay: bool) -> Result<Vec<ImportModule>, PeError> {
+        let index = if delay {
+            pe::IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT
+        } else {
+            pe::IMAGE_DIRECTORY_ENTRY_IMPORT
+        };
+        let Some((rva, size, directory_at)) = self.directory(index) else {
+            return Ok(Vec::new());
+        };
+        let descriptor_size = if delay { 32 } else { 20 };
+        // Windows tolerates underspecified import sizes. This untrusted-input
+        // reader requires the descriptor list, including its null terminator,
+        // to fit the advertised extent instead of walking neighboring data.
+        self.span(rva, size as usize, directory_at)?;
+        if (size as usize) < descriptor_size {
+            return Err(PeError::at(
+                directory_at + 4,
+                "import directory smaller than one descriptor",
+            ));
+        }
+        let mut modules = Vec::new();
+        for i in 0..=MAX_MODULES {
+            // Windows accepts an import size that excludes the terminating null descriptor, so the
+            // terminator index (`size / descriptor_size`) is allowed one past the last full
+            // descriptor in the extent. `span` still bounds the read against the mapping.
+            if i > size as usize / descriptor_size {
+                return Err(PeError::at(
+                    directory_at + 4,
+                    "import descriptor exceeds directory size",
+                ));
+            }
+            let pos = Self::add(rva, i * descriptor_size, directory_at)?;
+            let (at, bytes) = self.span(pos, descriptor_size, directory_at)?;
+            if bytes.iter().all(|&b| b == 0) {
+                return Ok(modules);
+            }
+            if i == MAX_MODULES {
+                return Err(PeError::at(at, "import module count exceeds limit"));
+            }
+            let word = |n| {
+                u32::from_le_bytes(bytes[n..n + 4].try_into().expect("descriptor span checked"))
+            };
+            let (name, int, iat, name_at, thunk_at) = if delay {
+                if word(0) != 1 {
+                    return Err(PeError::at(
+                        at,
+                        "delay imports must use RVA addressing (attributes = 1)",
+                    ));
+                }
+                (word(4), word(16), word(12), at + 4, at + 16)
+            } else {
+                let int = if word(0) == 0 { word(16) } else { word(0) };
+                (word(12), int, word(16), at + 12, at)
+            };
+            let dll = self.string(name, name_at)?;
+            let mut entries = Vec::new();
+            for n in 0..=MAX_ENTRIES {
+                let pos = Self::add(int, n * 8, thunk_at)?;
+                let (slot, value) = self.u64(pos, thunk_at)?;
+                if value == 0 {
+                    break;
+                }
+                if n == MAX_ENTRIES || self.entries == MAX_ENTRIES {
+                    return Err(PeError::at(slot, "total import count exceeds limit"));
+                }
+                let iat_slot_rva = Self::add(iat, n * 8, at)?;
+                if !iat_slot_rva
+                    .checked_add(8)
+                    .is_some_and(|end| end <= self.image_size)
+                {
+                    return Err(PeError::at(
+                        at + if delay { 12 } else { 16 },
+                        "IAT slot lies outside image",
+                    ));
+                }
+                let symbol = if value & (1 << 63) != 0 {
+                    if value & !(1 << 63 | 0xffff) != 0 {
+                        return Err(PeError::at(slot, "invalid ordinal thunk bits"));
+                    }
+                    ImportSymbol::Ordinal(value as u16)
+                } else {
+                    let name_rva = u32::try_from(value)
+                        .map_err(|_| PeError::at(slot, "import name RVA exceeds 32 bits"))?;
+                    let (hint_at, hint) = self.span(name_rva, 2, slot)?;
+                    let hint = u16::from_le_bytes(hint.try_into().expect("checked hint span"));
+                    let name = self.string(Self::add(name_rva, 2, hint_at)?, hint_at)?;
+                    if name.is_empty() {
+                        return Err(PeError::at(hint_at + 2, "empty import symbol"));
+                    }
+                    ImportSymbol::Name { hint, name }
+                };
+                self.charge(std::mem::size_of::<ImportEntry>(), slot)?;
+                self.entries += 1;
+                entries.push(ImportEntry {
+                    symbol,
+                    iat_slot_rva,
+                });
+            }
+            self.charge(std::mem::size_of::<ImportModule>(), at)?;
+            modules.push(ImportModule { dll, entries });
+        }
+        unreachable!("bounded descriptor loop returns at its limit")
+    }
+
+    pub(super) fn exports(&mut self, aliases: bool) -> Result<Vec<ExportInfo>, PeError> {
+        let Some((rva, size, directory_at)) = self.directory(pe::IMAGE_DIRECTORY_ENTRY_EXPORT)
+        else {
+            return Ok(Vec::new());
+        };
+        if size < 40 {
+            return Err(PeError::at(
+                directory_at + 4,
+                "export directory is smaller than its header",
+            ));
+        }
+        self.span(rva, size as usize, directory_at)?;
+        let (at, bytes) = self.span(rva, 40, directory_at)?;
+        let word =
+            |n| u32::from_le_bytes(bytes[n..n + 4].try_into().expect("checked directory span"));
+        let base = word(16);
+        let count = word(20) as usize;
+        let names = word(24) as usize;
+        if count > MAX_ENTRIES
+            || names > MAX_ENTRIES
+            || base > u16::MAX as u32
+            || base as u64 + count as u64 > 65_536
+        {
+            return Err(PeError::at(at + 16, "export ordinal/count exceeds limit"));
+        }
+        let addresses = word(28);
+        let pointers = word(32);
+        let ordinals = word(36);
+        if count != 0 {
+            self.span(addresses, count * 4, at + 28)?;
+        }
+        if names != 0 {
+            self.span(pointers, names * 4, at + 32)?;
+            self.span(ordinals, names * 2, at + 36)?;
+        }
+        self.charge(count * std::mem::size_of::<Option<ExportInfo>>(), at)?;
+        let mut slots = Vec::with_capacity(count);
+        for i in 0..count {
+            let (field, address) = self.u32(Self::add(addresses, i * 4, at + 28)?, at + 28)?;
+            if address == 0 {
+                slots.push(None);
+                continue;
+            }
+            let (rva_out, forward) = if address >= rva && address - rva < size {
+                let forward =
+                    self.string_limit(address, field, (size - (address - rva) - 1) as usize)?;
+                let Some((library, symbol)) = forward.rsplit_once('.') else {
+                    return Err(PeError::at(field, "forwarded export has no separator"));
+                };
+                if library.is_empty() || symbol.is_empty() {
+                    return Err(PeError::at(field, "empty forwarded export component"));
+                }
+                if let Some(digits) = symbol.strip_prefix('#') {
+                    if digits.is_empty() || digits.parse::<u16>().is_err() {
+                        return Err(PeError::at(field, "invalid forwarded ordinal"));
+                    }
+                }
+                (None, Some(forward))
+            } else {
+                if address >= self.image_size {
+                    return Err(PeError::at(field, "export address lies outside image"));
+                }
+                (Some(address), None)
+            };
+            slots.push(Some(ExportInfo {
+                name: None,
+                ordinal: (base + i as u32) as u16,
+                rva: rva_out,
+                forward,
+            }));
+        }
+        let mut named = Vec::new();
+        let mut seen = vec![false; count];
+        for i in 0..names {
+            let (field, name) = self.u32(Self::add(pointers, i * 4, at + 32)?, at + 32)?;
+            let (ordinal_at, index) =
+                self.span(Self::add(ordinals, i * 2, at + 36)?, 2, at + 36)?;
+            let index =
+                u16::from_le_bytes(index.try_into().expect("checked ordinal span")) as usize;
+            let slot = slots.get_mut(index).ok_or_else(|| {
+                PeError::at(ordinal_at, "export ordinal index exceeds address table")
+            })?;
+            let name = self.string(name, field)?;
+            if let Some(export) = slot {
+                if aliases {
+                    self.charge(
+                        std::mem::size_of::<ExportInfo>()
+                            + export.forward.as_ref().map_or(0, String::len),
+                        field,
+                    )?;
+                    let mut export = export.clone();
+                    export.name = Some(name);
+                    named.push(export);
+                    seen[index] = true;
+                } else {
+                    export.name = Some(name);
+                }
+            }
+        }
+        if aliases {
+            for (i, slot) in slots.into_iter().enumerate() {
+                if !seen[i] {
+                    if let Some(export) = slot {
+                        named.push(export);
+                    }
+                }
+            }
+            Ok(named)
+        } else {
+            Ok(slots.into_iter().flatten().collect())
+        }
+    }
+
+    pub(super) fn tls(&mut self, image_base: u64) -> Result<Option<TlsInfo>, PeError> {
+        let Some((rva, size, field)) = self.directory(pe::IMAGE_DIRECTORY_ENTRY_TLS) else {
+            return Ok(None);
+        };
+        if size < 40 {
+            return Err(PeError::at(
+                field + 4,
+                "TLS directory is smaller than its header",
+            ));
+        }
+        self.span(rva, size as usize, field)?;
+        let (at, bytes) = self.span(rva, 40, field)?;
+        let callbacks_va = u64::from_le_bytes(bytes[24..32].try_into().expect("checked TLS span"));
+        let mut callback_rvas = Vec::new();
+        if callbacks_va != 0 {
+            let va_to_rva = |va: u64, at| {
+                va.checked_sub(image_base)
+                    .and_then(|n| u32::try_from(n).ok())
+                    .filter(|&n| n < self.image_size)
+                    .ok_or_else(|| PeError::at(at, "TLS VA lies outside image"))
+            };
+            let array = va_to_rva(callbacks_va, at + 24)?;
+            for i in 0..=MAX_TLS_CALLBACKS {
+                let pos = Self::add(array, i * 8, at + 24)?;
+                let (slot, value) = self.u64(pos, at + 24)?;
+                if value == 0 {
+                    return Ok(Some(TlsInfo {
+                        directory_rva: rva,
+                        callbacks_va,
+                        callback_rvas,
+                    }));
+                }
+                if i == MAX_TLS_CALLBACKS {
+                    return Err(PeError::at(slot, "TLS callback count exceeds limit"));
+                }
+                callback_rvas.push(va_to_rva(value, slot)?);
+            }
+        }
+        Ok(Some(TlsInfo {
+            directory_rva: rva,
+            callbacks_va,
+            callback_rvas,
+        }))
+    }
+}
