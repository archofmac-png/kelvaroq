+++ b/crates/victory-formats/src/rpf9.rs
@@ -0,0 +1,105 @@
+//! Checked RPF9 table envelope. Entry/encryption layouts are not yet established.
+//!
+//! The reference probe establishes `9FPR`, full prefix length at 4, partial
+//! prefix length at 8, and `16 <= partial <= full <= file length`.
+//! We expose the two table regions as borrowed bytes, never guessed records.
+
+use std::fmt;
+
+pub const MAX_TABLE_BYTES: usize = 16 * 1024 * 1024;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ErrorKind {
+    Truncated,
+    Magic,
+    Bounds,
+    Limit,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Error {
+    /// File-relative offset of the invalid field, or first missing byte.
+    pub offset: usize,
+    pub kind: ErrorKind,
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "RPF9 at {:#x}: {:?}", self.offset, self.kind)
+    }
+}
+impl std::error::Error for Error {}
+
+#[derive(Debug)]
+pub struct Table<'a> {
+    pub partial: &'a [u8],
+    pub remainder: &'a [u8],
+    /// Uninterpreted fourth header word. No flags/layout assumptions.
+    pub opaque: u32,
+}
+
+impl<'a> Table<'a> {
+    pub fn parse(data: &'a [u8]) -> Result<Self, Error> {
+        if data.len() < 16 {
+            return Err(Error {
+                offset: data.len(),
+                kind: ErrorKind::Truncated,
+            });
+        }
+        if &data[..4] != b"9FPR" {
+            return Err(Error {
+                offset: 0,
+                kind: ErrorKind::Magic,
+            });
+        }
+        // Fixed header length was checked above; no untrusted-length allocation.
+        let word = |at| u32::from_le_bytes(data[at..at + 4].try_into().expect("checked header"));
+        let full = word(4) as usize;
+        let partial = word(8) as usize;
+        if partial < 16 || partial > full {
+            return Err(Error {
+                offset: 8,
+                kind: ErrorKind::Bounds,
+            });
+        }
+        if full > MAX_TABLE_BYTES {
+            return Err(Error {
+                offset: 4,
+                kind: ErrorKind::Limit,
+            });
+        }
+        if full > data.len() {
+            return Err(Error {
+                offset: 4,
+                kind: ErrorKind::Bounds,
+            });
+        }
+        Ok(Self {
+            partial: &data[16..partial],
+            remainder: &data[partial..full],
+            opaque: word(12),
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn checks_prefix_extents_before_slicing() {
+        let mut data = b"9FPR".to_vec();
+        for word in [24u32, 20, 0] {
+            data.extend_from_slice(&word.to_le_bytes());
+        }
+        data.extend_from_slice(&[1; 8]);
+        let table = Table::parse(&data).unwrap();
+        assert_eq!(table.partial, &[1; 4]);
+        assert_eq!(table.remainder, &[1; 4]);
+        data[8..12].copy_from_slice(&25u32.to_le_bytes());
+        assert_eq!(Table::parse(&data).unwrap_err().offset, 8);
+        data[8..12].copy_from_slice(&16u32.to_le_bytes());
+        data[4..8].copy_from_slice(&u32::MAX.to_le_bytes());
+        assert_eq!(Table::parse(&data).unwrap_err().kind, ErrorKind::Limit);
+    }
+}
