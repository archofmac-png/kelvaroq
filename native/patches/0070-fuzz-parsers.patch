+//! Identical byte consumers for libFuzzer and stable `cargo test`.
+use std::sync::OnceLock;
+use victory_formats::{bcpack as bc, rpf9 as rpf};
+
+pub fn rpf9(data: &[u8]) -> Result<(), rpf::Error> {
+    rpf::Table::parse(data).map(|_| ())
+}
+
+/// Fuzz-only framing: BC number u8, output block count u16 LE, packed bytes.
+/// The decoder itself takes an out-of-band format and output slice.
+pub fn bcpack(data: &[u8]) -> Result<(), bc::Error> {
+    if data.len() < 3 {
+        return Err(bc::Error {
+            offset: data.len(),
+            reason: "truncated fuzz framing",
+        });
+    }
+    let blocks = u16::from_le_bytes([data[1], data[2]]) as usize;
+    if blocks == 0 || blocks > 256 {
+        return Err(bc::Error {
+            offset: 1,
+            reason: "fuzz output block count outside 1..=256",
+        });
+    }
+    let size = match data[0] {
+        1 | 4 => 8,
+        3 | 5 | 6 | 7 => 16,
+        _ => {
+            return Err(bc::Error {
+                offset: 0,
+                reason: "unsupported BC format",
+            });
+        }
+    };
+    static TABLES: OnceLock<Result<bc::Tables, bc::Error>> = OnceLock::new();
+    let tables = TABLES
+        .get_or_init(bc::Tables::builtin)
+        .as_ref()
+        .map_err(|e| *e)?;
+    let mut output = vec![0; blocks * size]; // <= 4096 bytes; records <= 8192.
+    bc::decode(data[0], &data[3..], &mut output, tables).map_err(|mut e| {
+        e.offset += 3;
+        e
+    })
+}
+
+pub fn shader_header(data: &[u8]) -> Result<(), victory_shader::ShaderError> {
+    victory_shader::Container::parse(data).map(|_| ())
+}
+
+pub fn pe(data: &[u8]) -> Result<(), victory_pe::PeError> {
+    victory_pe::ImageInfo::parse(data)?;
+    victory_pe::ImageInfo::parse_with_aliases(data).map(|_| ())
+}
+
+#[cfg(test)]
+mod seeds;
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn consume(target: &str, bytes: &[u8]) -> bool {
+        match target {
+            "rpf9" => match rpf9(bytes) {
+                Ok(()) => true,
+                Err(e) => {
+                    assert!(e.offset <= bytes.len());
+                    false
+                }
+            },
+            "bcpack" => match bcpack(bytes) {
+                Ok(()) => true,
+                Err(e) => {
+                    assert!(e.offset <= bytes.len());
+                    false
+                }
+            },
+            "shader_header" => match shader_header(bytes) {
+                Ok(()) => true,
+                Err(victory_shader::ShaderError::Bytes { offset, .. }) => {
+                    assert!(offset <= bytes.len());
+                    false
+                }
+                Err(e) => panic!("missing byte offset: {e}"),
+            },
+            "pe" => match pe(bytes) {
+                Ok(()) => true,
+                Err(e) => {
+                    assert!(e.offset().is_some_and(|at| at <= bytes.len()));
+                    false
+                }
+            },
+            _ => panic!("unknown corpus target"),
+        }
+    }
+
+    #[test]
+    fn corpus_and_200_mutations_per_seed() {
+        let mut total = 0;
+        for (target, name, original, valid) in seeds::all() {
+            let disk = std::fs::read(
+                std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+                    .join("seeds")
+                    .join(target)
+                    .join(name),
+            )
+            .unwrap();
+            assert_eq!(disk, original, "synthetic seed drift: {target}/{name}");
+            assert_eq!(
+                consume(target, &disk),
+                valid,
+                "seed outcome: {target}/{name}"
+            );
+            // Direct calls: a panic fails the test; there is no panic suppression.
+            for i in 0usize..200 {
+                let mut bytes = disk.clone();
+                let mut state = 0x9e37_79b9u32 ^ (i as u32).wrapping_mul(0x85eb_ca6b);
+                let mut next = || {
+                    state ^= state << 13;
+                    state ^= state >> 17;
+                    state ^= state << 5;
+                    state
+                };
+                match i % 5 {
+                    0 => {
+                        bytes.truncate((next() as usize) % (bytes.len() + 1));
+                    }
+                    1 if !bytes.is_empty() => {
+                        let at = next() as usize % bytes.len();
+                        bytes[at] ^= 1 << (next() % 8);
+                    }
+                    2 if !bytes.is_empty() => {
+                        let at = next() as usize % bytes.len();
+                        let end = (at + 4).min(bytes.len());
+                        bytes[at..end].fill(if i & 1 == 0 { 0xff } else { 0 });
+                    }
+                    3 => {
+                        let at = next() as usize % (bytes.len() + 1);
+                        bytes.insert(at, next() as u8);
+                    }
+                    _ => {
+                        if !bytes.is_empty() {
+                            let at = next() as usize % bytes.len();
+                            bytes.remove(at);
+                        }
+                    }
+                }
+                let _ = consume(target, &bytes);
+                total += 1;
+            }
+        }
+        println!("{total} deterministic mutated inputs survived");
+    }
+
+    #[test]
+    fn every_prefix_of_valid_seeds() {
+        for (target, name, bytes, valid) in seeds::all() {
+            if !valid {
+                continue;
+            }
+            for len in 0..bytes.len() {
+                let _ = consume(target, &bytes[..len]);
+            }
+            assert!(consume(target, &bytes), "{target}/{name}");
+        }
+    }
+}
