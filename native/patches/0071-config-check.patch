+/// Everything `--check-config` finds wrong, one entry per problem. A config
+/// that does not parse stops the later checks (there is no config to check);
+/// after that, each check runs whatever the others found.
+fn check_config() -> Vec<String> {
+    let cfg = match victory_core::Config::load() {
+        Ok(cfg) => cfg,
+        Err(e) => return vec![describe_load_error(&e)],
+    };
+    let mut problems = Vec::new();
+    if let Err(e) = cfg.require_game_dir() {
+        problems.push(format!("game_dir: {e:#}"));
+    }
+    for (what, sub) in [("cache_dir", cfg.cache_subdir("shaders")), ("cache_dir", cfg.cache_subdir("images"))] {
+        if let Err(e) = sub {
+            problems.push(format!("{what}: {e:#}"));
+        }
+    }
+    if let Err(e) = cfg.data_subdir("") {
+        problems.push(format!("data_dir: {e:#}"));
+    }
+    problems
+}
+
+/// A parse error is shown as `file:line:column: message`, the source line
+/// and a caret; serde's message (which names the field) is kept verbatim.
+fn describe_load_error(e: &anyhow::Error) -> String {
+    let Some(pe) = e.downcast_ref::<victory_core::ParseError>() else {
+        return format!("config: {e:#}");
+    };
+    match pe.location() {
+        Some(at) => format!(
+            "{}:{}:{}: {}\n  {}\n  {}^",
+            pe.path.display(),
+            at.line,
+            at.column,
+            pe.message().trim_end(),
+            at.source_line,
+            " ".repeat(at.column - 1),
+        ),
+        None => format!("{}: {}", pe.path.display(), pe.message().trim_end()),
+    }
+}
