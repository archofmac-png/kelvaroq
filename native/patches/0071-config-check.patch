+/// The config file did not parse. Keeps the text and the `toml` error so a
+/// caller can point at the offending line (`--check-config`); the error
+/// chain reads as before ("parsing <path>" caused by toml's message).
+#[derive(Debug)]
+pub struct ParseError {
+    pub path: PathBuf,
+    pub text: String,
+    pub error: toml::de::Error,
+}
+
+/// Where a [`ParseError`] points: 1-based line and column (in characters)
+/// and the text of that line.
+#[derive(Debug, PartialEq, Eq)]
+pub struct Location<'a> {
+    pub line: usize,
+    pub column: usize,
+    pub source_line: &'a str,
+}
+
+impl ParseError {
+    /// The error's own message (serde's, so it names the field).
+    pub fn message(&self) -> &str {
+        self.error.message()
+    }
+
+    /// The start of the offending span, if `toml` gave one.
+    pub fn location(&self) -> Option<Location<'_>> {
+        let start = self.error.span()?.start.min(self.text.len());
+        let start = (0..=start).rev().find(|&i| self.text.is_char_boundary(i))?;
+        let before = &self.text[..start];
+        let line_start = before.rfind('\n').map_or(0, |i| i + 1);
+        let line_end = self.text[start..]
+            .find('\n')
+            .map_or(self.text.len(), |i| start + i);
+        Some(Location {
+            line: before.matches('\n').count() + 1,
+            column: self.text[line_start..start].chars().count() + 1,
+            source_line: self.text[line_start..line_end].trim_end_matches('\r'),
+        })
+    }
+}
+
+impl std::fmt::Display for ParseError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "parsing {}", self.path.display())
+    }
+}
+
+impl std::error::Error for ParseError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.error)
+    }
+}
