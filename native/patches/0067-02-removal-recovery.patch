+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn a_failed_generation_cannot_replace_a_good_one() {
+        let root = tempfile::tempdir().unwrap();
+        let good = publish(root.path(), |at| {
+            write_verified(&at.join("ram"), |w| w.write_all(b"old RAM"))?;
+            Ok(())
+        })
+        .unwrap();
+        let complete = fs::read(good.join("COMPLETE")).unwrap();
+        let result = publish(root.path(), |at| {
+            write_verified(&at.join("ram"), |w| {
+                w.write_all(b"partial")?;
+                Err(invalid("disk full"))
+            })?;
+            Ok(())
+        });
+        assert!(result.is_err());
+        assert_eq!(fs::read(good.join("ram")).unwrap(), b"old RAM");
+        assert_eq!(fs::read(good.join("COMPLETE")).unwrap(), complete);
+        assert_eq!(
+            fs::read_dir(root.path())
+                .unwrap()
+                .filter(|e| !e
+                    .as_ref()
+                    .unwrap()
+                    .file_name()
+                    .to_string_lossy()
+                    .ends_with(".partial"))
+                .count(),
+            1
+        );
+        assert!(write_verified(&good.join("ram"), |_| Ok(())).is_err());
+    }
+    #[test]
+    fn copied_save_state_is_independent_and_verified() {
+        let root = tempfile::tempdir().unwrap();
+        let source = root.path().join("saves");
+        fs::create_dir(&source).unwrap();
+        fs::write(source.join("blob"), b"saved").unwrap();
+        let copy = root.path().join("copy");
+        copy_tree(&source, &copy).unwrap();
+        fs::write(source.join("blob"), b"next").unwrap();
+        assert_eq!(fs::read(copy.join("blob")).unwrap(), b"saved");
+        assert_eq!(json_string("a\n\"\\\0"), "\"a\\n\\\"\\\\\\u0000\"");
+    }
+    #[test]
+    fn clone_archive_is_readable() {
+        // No title or driver data. Guarded private RAM must be captured without
+        // disarming the live process's memory tracking.
+        use windows_sys::Win32::System::Memory::*;
+        struct Page(*mut std::ffi::c_void);
+        impl Drop for Page {
+            fn drop(&mut self) {
+                unsafe {
+                    VirtualFree(self.0, 0, MEM_RELEASE);
+                }
+            }
+        }
+        let page = Page(unsafe {
+            VirtualAlloc(
+                std::ptr::null(),
+                4096,
+                MEM_RESERVE | MEM_COMMIT,
+                PAGE_READWRITE,
+            )
+        });
+        assert!(!page.0.is_null());
+        unsafe {
+            page.0.cast::<u8>().write_bytes(0x67, 4096);
+        }
+        let mut old = 0;
+        assert_ne!(
+            unsafe { VirtualProtect(page.0, 4096, PAGE_READWRITE | PAGE_GUARD, &mut old) },
+            0
+        );
+        let root = tempfile::tempdir().unwrap();
+        let file = root.path().join("ram.bin");
+        let start = std::time::Instant::now();
+        let bytes = capture_ram(&file).unwrap();
+        eprintln!(
+            "PSS archive: {bytes} bytes verified in {:?}",
+            start.elapsed()
+        );
+        assert!(bytes > 4096);
+        let mut input = File::open(file).unwrap();
+        let mut magic = [0; 9];
+        input.read_exact(&mut magic).unwrap();
+        assert_eq!(&magic, b"SCARLRAM1");
+        let mut regions = 0;
+        let mut guarded = false;
+        loop {
+            let mut record = [0; 24];
+            input.read_exact(&mut record).unwrap();
+            let len = u64::from_le_bytes(record[8..16].try_into().unwrap());
+            if record == [0; 24] {
+                break;
+            }
+            assert!(len > 0);
+            let base = u64::from_le_bytes(record[..8].try_into().unwrap());
+            if base == page.0 as u64 {
+                let mut bytes = vec![0; len as usize];
+                input.read_exact(&mut bytes).unwrap();
+                assert_eq!(bytes, vec![0x67; 4096]);
+                assert_ne!(
+                    u32::from_le_bytes(record[16..20].try_into().unwrap()) & PAGE_GUARD,
+                    0
+                );
+                guarded = true;
+            } else {
+                assert_eq!(
+                    io::copy(&mut (&mut input).take(len), &mut io::sink()).unwrap(),
+                    len
+                );
+            }
+            regions += 1;
+        }
+        assert!(regions > 0 && guarded);
+        let mut live = MEMORY_BASIC_INFORMATION::default();
+        assert_ne!(
+            unsafe { VirtualQuery(page.0, &mut live, size_of_val(&live)) },
+            0
+        );
+        assert_ne!(live.Protect & PAGE_GUARD, 0, "live guard must remain armed");
+        assert_eq!(input.read(&mut [0]).unwrap(), 0);
+    }
+}
