index 0000000..1c676bd
--- /dev/null
+++ b/crates/victory-gpu/src/removal.rs
@@ -0,0 +1,82 @@
+//! Removal reports own their DRED text; no runtime pointers escape the device.
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+pub fn enabled() -> bool {
+    std::env::var_os("VICTORY_RECOVER_REMOVAL").is_some_and(|v| v == "1")
+}
+
+/// A failing removal reason is authoritative even when the triggering call
+/// returned E_FAIL (or the reason itself is DEVICE_HUNG/DRIVER_INTERNAL_ERROR).
+pub fn is_removal(call_hr: i32, reason: i32) -> bool {
+    matches!(call_hr as u32, 0x887a0005 | 0x887a0007) || reason < 0
+}
+
+#[derive(Debug)]
+pub struct Removal {
+    pub reason: i32,
+    /// Pending breadcrumb operations, not a claim about simultaneous execution.
+    pub in_flight_commands: Option<u64>,
+    pub dred: String,
+    pub fault: String,
+}
+
+static REPORT: OnceLock<fn(&Removal) -> !> = OnceLock::new();
+pub fn on_removal(report: fn(&Removal) -> !) {
+    let _ = REPORT.set(report);
+}
+
+pub(crate) fn report(event: &Removal) {
+    if enabled()
+        && let Some(report) = REPORT.get()
+    {
+        report(event);
+    }
+}
+
+/// Lifetime budget: successful recovery must not reset it. Shared by every
+/// removal source, with no fourth concurrent claimant or wrapping counter.
+#[derive(Default)]
+pub struct AttemptBudget(AtomicU32);
+impl AttemptBudget {
+    pub fn take(&self) -> Option<u32> {
+        self.0
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
+                (n < 3).then_some(n + 1)
+            })
+            .ok()
+            .map(|n| n + 1)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn ordinary_faults_are_not_removals() {
+        assert!(!is_removal(0x80004005_u32 as i32, 0));
+        for hr in [0x887a0005_u32, 0x887a0007] {
+            assert!(is_removal(hr as i32, 0));
+        }
+        assert!(is_removal(0x80004005_u32 as i32, 0x887a0006_u32 as i32));
+    }
+    #[test]
+    fn three_attempts_across_all_threads() {
+        let budget = std::sync::Arc::new(AttemptBudget::default());
+        let threads: Vec<_> = (0..32)
+            .map(|_| {
+                let budget = budget.clone();
+                std::thread::spawn(move || budget.take())
+            })
+            .collect();
+        let mut granted: Vec<_> = threads
+            .into_iter()
+            .filter_map(|t| t.join().unwrap())
+            .collect();
+        granted.sort();
+        assert_eq!(granted, [1, 2, 3]);
+        for _ in 0..100 {
+            assert_eq!(budget.take(), None);
+        }
+    }
+}
