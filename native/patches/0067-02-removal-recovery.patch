+/// Publish only after every artifact is verified. A failed generation remains
+/// visibly .partial; previous published generations are never renamed/deleted.
+pub fn publish(root: &Path, write: impl FnOnce(&Path) -> io::Result<()>) -> io::Result<PathBuf> {
+    static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+    fs::create_dir_all(root)?;
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(|_| invalid("clock before epoch"))?
+        .as_nanos();
+    let name = format!(
+        "snapshot-{now}-{}-{}",
+        std::process::id(),
+        SEQUENCE.fetch_add(1, Ordering::Relaxed)
+    );
+    let partial = root.join(format!("{name}.partial"));
+    let complete = root.join(name);
+    fs::create_dir(&partial)?;
+    write(&partial)?;
+    // A manifest authenticates all files before the commit rename. Rehash the
+    // actual tree again after writing it, so unreadable/corrupt output is rejected.
+    fn inventory(root: &Path, at: &Path, out: &mut String) -> io::Result<()> {
+        let mut entries = fs::read_dir(at)?.collect::<io::Result<Vec<_>>>()?;
+        entries.sort_by_key(|e| e.file_name());
+        for entry in entries {
+            let path = entry.path();
+            if entry.file_type()?.is_dir() {
+                inventory(root, &path, out)?;
+            } else if entry.file_type()?.is_file() {
+                let (bytes, digest) = hash(&path)?;
+                out.push_str(&format!(
+                    "{digest} {bytes} {:?}\n",
+                    path.strip_prefix(root).map_err(io::Error::other)?
+                ));
+            } else {
+                return Err(invalid("snapshot contains a link"));
+            }
+        }
+        Ok(())
+    }
+    let mut before = String::new();
+    inventory(&partial, &partial, &mut before)?;
+    if before.is_empty() {
+        return Err(invalid("empty recovery snapshot"));
+    }
+    let mut again = String::new();
+    inventory(&partial, &partial, &mut again)?;
+    if before != again {
+        return Err(invalid("snapshot changed during verification"));
+    }
+    write_verified(&partial.join("COMPLETE"), |out| {
+        out.write_all(before.as_bytes())
+    })?;
+    fs::rename(&partial, &complete)?;
+    Ok(complete)
+}
