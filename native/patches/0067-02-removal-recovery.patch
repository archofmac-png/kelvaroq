diff --git a/crates/victory-hle/src/modules/d3d12x/recovery.rs b/crates/victory-hle/src/modules/d3d12x/recovery.rs
new file mode 100644
index 0000000..5a87d27
--- /dev/null
+++ b/crates/victory-hle/src/modules/d3d12x/recovery.rs
@@ -0,0 +1,268 @@
+//! Fail closed until the runtime has a replayable CPU/GPU checkpoint and
+//! replaceable device generations. Never reinterpret a RAM dump as one.
+use std::sync::atomic::{AtomicBool, Ordering};
+use victory_gpu::removal::Removal;
+use victory_loader::recovery::{capture_ram, copy_tree, json_string, publish, write_verified};
+
+const UNSAFE_RESUME: u32 = 0xe0670001;
+const PRESERVE_FAILED: u32 = 0xe0670002;
+
+fn enter_failure() {
+    // No other GPU fault may terminate the process while the first observer
+    // is preserving it. All enabled failure routes share this gate.
+    static HANDLING: AtomicBool = AtomicBool::new(false);
+    if HANDLING.swap(true, Ordering::AcqRel) {
+        loop {
+            std::thread::park();
+        }
+    }
+}
+
+pub(super) fn removed(event: &Removal) -> ! {
+    enter_failure();
+    let title = crate::runtime::title();
+    let root = title.storage.with_file_name("recovery");
+    let mut partial = None;
+    let mut artifacts = Vec::new();
+    let preserved = if title.storage.as_os_str().is_empty() {
+        Err(std::io::Error::other("title storage not configured"))
+    } else {
+        publish(&root, |at| {
+            partial = Some(at.to_owned());
+            let mut errors = Vec::new();
+            let mut record = |name, result: std::io::Result<()>| match result {
+                Ok(()) => artifacts.push(name),
+                Err(e) => errors.push(format!("{name}: {e}")),
+            };
+            record(
+                "dred",
+                write_verified(&at.join("dred.txt"), |out| {
+                    out.write_all(event.dred.as_bytes())?;
+                    out.write_all(event.fault.as_bytes())
+                })
+                .map(|_| ()),
+            );
+            // Attempt artifacts independently: an active save or a full disk
+            // must not prevent trying to retain the other recoverable state.
+            record("ram", capture_ram(&at.join("ram.bin")).map(|_| ()));
+            // All XGameSave commits use this same lock. Do not block on a
+            // possibly faulting thread; reject an inconsistent save copy.
+            record(
+                "saves",
+                super::super::xgamesave::recovery_copy(&title.saves(), &at.join("saves")),
+            );
+            record("storage", copy_tree(&title.storage, &at.join("storage")));
+            write_verified(&at.join("README.txt"), |out| {
+                out.write_all(
+                b"Forensic snapshot; not a resumable checkpoint. ram.bin contains cloneable readable process RAM. Shared pages and storage may change during capture. GPU-only writes may be lost. Keep all generations; COMPLETE lists verified files. Saves are a copy of committed on-disk XGameSave state; unsaved progress is not guaranteed.\n")
+            })?;
+            if errors.is_empty() {
+                Ok(())
+            } else {
+                Err(std::io::Error::other(errors.join("; ")))
+            }
+        })
+    };
+    let (code, outcome, folder, detail) = match preserved {
+        Ok(folder) => (UNSAFE_RESUME, "exit_unsafe_resume", folder, String::new()),
+        Err(e) => (
+            PRESERVE_FAILED,
+            "exit_snapshot_failed",
+            partial.unwrap_or(root),
+            e.to_string(),
+        ),
+    };
+    let artifacts = artifacts.join(",");
+    // CPU bytes alone cannot prove intact state: GPU hand-back may have been
+    // lost, and OnceLock device children cannot be invalidated/replayed. Zero
+    // recovery attempts are made for this unsafe state (never a restart loop).
+    let count = event
+        .in_flight_commands
+        .map_or("null".into(), |n| n.to_string());
+    let timestamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis());
+    let kind = if event.reason as u32 == 0x887a0007 {
+        "device_reset"
+    } else {
+        "device_removed"
+    };
+    let line = format!(
+        "{{\"timestamp_unix_ms\":{timestamp},\"kind\":\"{kind}\",\"reason\":{},\"in_flight_commands\":{count},\"preserved\":{},\"recovery_attempted\":false,\"attempts\":0,\"attempt_cap\":3,\"outcome\":{},\"folder\":{},\"error\":{},\"dred\":{},\"fault\":{}}}",
+        event.reason,
+        json_string(&artifacts),
+        json_string(outcome),
+        json_string(&folder.to_string_lossy()),
+        json_string(&detail),
+        json_string(&event.dred),
+        json_string(&event.fault)
+    );
+    if let Err(e) = victory_loader::log_crash_event(&line) {
+        eprintln!("recovery report could not be persisted: {e}");
+    }
+    eprintln!(
+        "GPU recovery stopped ({outcome}); keep recovery folder: {}",
+        folder.display()
+    );
+    super::terminate(code)
+}
+
+pub(super) fn ordinary_fault(what: &str) {
+    enter_failure();
+    let timestamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis());
+    let line = format!(
+        "{{\"timestamp_unix_ms\":{timestamp},\"kind\":\"gpu_fault\",\"in_flight_commands\":null,\"preserved\":\"none\",\"recovery_attempted\":false,\"attempts\":0,\"outcome\":\"exit_fault\",\"fault\":{}}}",
+        json_string(what)
+    );
+    if let Err(e) = victory_loader::log_crash_event(&line) {
+        eprintln!("GPU fault report could not be persisted: {e}");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::{Duration, Instant};
+    const CHILD: &str = "VICTORY_0067_PRESERVE_CHILD";
+    const TEST: &str =
+        "modules::d3d12x::recovery::tests::removal_preserves_and_reports_or_retains_legacy_exit";
+    struct Child(std::process::Child);
+    impl Drop for Child {
+        fn drop(&mut self) {
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+    #[test]
+    fn removal_preserves_and_reports_or_retains_legacy_exit() {
+        if let Some(root) = std::env::var_os(CHILD) {
+            let root = std::path::PathBuf::from(root);
+            let storage = root.join("storage");
+            std::fs::create_dir(&storage).unwrap();
+            let saves = root.join("saves");
+            std::fs::create_dir(&saves).unwrap();
+            std::fs::write(saves.join("blob"), b"committed save").unwrap();
+            crate::runtime::set_title(crate::runtime::Title {
+                storage,
+                ..Default::default()
+            });
+            victory_loader::log_crashes_to(root.join("crashes.log"));
+            if victory_gpu::removal::enabled() {
+                if std::env::var_os("VICTORY_0067_BUSY_SAVE").is_some() {
+                    super::super::super::xgamesave::recovery_test_busy(|| removed(&event()));
+                }
+                removed(&event());
+            }
+            super::super::host_gpu_failed("legacy test");
+        }
+        for (enabled, busy, code) in [
+            (false, false, 0x887a0005),
+            (true, false, UNSAFE_RESUME),
+            (true, true, PRESERVE_FAILED),
+        ] {
+            let root = tempfile::tempdir().unwrap();
+            let prior = root.path().join("recovery/previous");
+            std::fs::create_dir_all(&prior).unwrap();
+            std::fs::write(prior.join("COMPLETE"), b"prior verified snapshot").unwrap();
+            let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+            command
+                .args(["--exact", TEST, "--nocapture"])
+                .env(CHILD, root.path())
+                .env("VICTORY_RECOVER_REMOVAL", if enabled { "1" } else { "0" });
+            if busy {
+                command.env("VICTORY_0067_BUSY_SAVE", "1");
+            } else {
+                command.env_remove("VICTORY_0067_BUSY_SAVE");
+            }
+            let mut child = Child(command.spawn().unwrap());
+            let start = Instant::now();
+            let status = loop {
+                if let Some(status) = child.0.try_wait().unwrap() {
+                    break status;
+                }
+                assert!(
+                    start.elapsed() < Duration::from_secs(30),
+                    "preservation child timed out"
+                );
+                std::thread::sleep(Duration::from_millis(10));
+            };
+            assert_eq!(status.code().unwrap() as u32, code);
+            assert_eq!(
+                std::fs::read(prior.join("COMPLETE")).unwrap(),
+                b"prior verified snapshot"
+            );
+            let log = std::fs::read_to_string(root.path().join("crashes.log")).unwrap();
+            if enabled {
+                assert_eq!(log.lines().count(), 1, "one physical JSON event line");
+                for field in [
+                    "timestamp_unix_ms",
+                    "kind",
+                    "in_flight_commands",
+                    "preserved",
+                    "recovery_attempted",
+                    "outcome",
+                ] {
+                    assert!(log.contains(&format!("\"{field}\":")), "missing {field}");
+                }
+                assert!(log.contains("\"attempts\":0"));
+                assert!(log.contains(if busy {
+                    "exit_snapshot_failed"
+                } else {
+                    "exit_unsafe_resume"
+                }));
+                if busy {
+                    let partial = std::fs::read_dir(root.path().join("recovery"))
+                        .unwrap()
+                        .map(|e| e.unwrap().path())
+                        .find(|p| p.extension().is_some_and(|e| e == "partial"))
+                        .unwrap();
+                    assert!(partial.join("ram.bin").metadata().unwrap().len() > 4096);
+                    assert!(!partial.join("COMPLETE").exists());
+                    assert!(log.contains("dred,ram,storage"));
+                }
+                if !busy {
+                    let generation = std::fs::read_dir(root.path().join("recovery"))
+                        .unwrap()
+                        .map(|e| e.unwrap().path())
+                        .find(|p| {
+                            p.file_name()
+                                .unwrap()
+                                .to_string_lossy()
+                                .starts_with("snapshot-")
+                        })
+                        .unwrap();
+                    assert!(generation.join("COMPLETE").is_file());
+                    assert!(generation.join("ram.bin").metadata().unwrap().len() > 4096);
+                    assert_eq!(
+                        std::fs::read(generation.join("saves/blob")).unwrap(),
+                        b"committed save"
+                    );
+                    assert!(
+                        std::fs::read_to_string(generation.join("dred.txt"))
+                            .unwrap()
+                            .contains("Dispatch")
+                    );
+                }
+            } else {
+                assert!(log.contains("VIctory: host GPU failure: legacy test"));
+                assert!(!log.contains("recovery_attempted"));
+                assert_eq!(
+                    std::fs::read_dir(root.path().join("recovery"))
+                        .unwrap()
+                        .count(),
+                    1
+                );
+            }
+        }
+    }
+    fn event() -> Removal {
+        Removal {
+            reason: 0x887a0005_u32 as i32,
+            in_flight_commands: Some(2),
+            dred: "Dispatch\nDrawInstanced".into(),
+            fault: "test removal".into(),
+        }
+    }
+}
