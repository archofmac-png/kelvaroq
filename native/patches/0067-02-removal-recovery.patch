@@ -0,0 +1,268 @@
+//! Destructive software-device probes run only in a disposable child process.
+//!
+//! This proves D3D12 reconstruction after releasing every device child. It is
+//! deliberately not evidence that a running title's state can be resumed.
+
+use std::process::{Child, Command};
+use std::time::{Duration, Instant};
+
+use windows::Win32::Foundation::{CloseHandle, E_FAIL, WAIT_OBJECT_0};
+use windows::Win32::Graphics::Direct3D::D3D_FEATURE_LEVEL_12_0;
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::DXGI_ERROR_DEVICE_REMOVED;
+use windows::Win32::System::Threading::{CreateEventW, WaitForSingleObject};
+use windows::core::Interface;
+
+struct ChildGuard(Child);
+
+impl Drop for ChildGuard {
+    fn drop(&mut self) {
+        // A timeout or assertion must not leave a destructive probe running.
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+#[test]
+fn warp_removal_reconstructs_three_times_and_refuses_a_fourth() {
+    const CHILD: &str = "VICTORY_0067_REMOVAL_WARP_CHILD";
+    if std::env::var_os(CHILD).is_some() {
+        probe();
+        return;
+    }
+    let child = Command::new(std::env::current_exe().expect("test executable"))
+        .args([
+            "--exact",
+            "removal_warp_tests::warp_removal_reconstructs_three_times_and_refuses_a_fourth",
+            "--nocapture",
+        ])
+        .env(CHILD, "1")
+        .spawn()
+        .expect("isolated removal probe");
+    let mut child = ChildGuard(child);
+    let started = Instant::now();
+    loop {
+        if let Some(status) = child.0.try_wait().expect("poll removal probe") {
+            assert!(
+                status.success(),
+                "isolated WARP removal probe failed: {status}"
+            );
+            return;
+        }
+        assert!(
+            started.elapsed() < Duration::from_secs(30),
+            "WARP removal probe timed out after 30 s"
+        );
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[test]
+fn warp_removal_routes_through_host_failure_with_the_flag_on_and_off() {
+    const CHILD: &str = "VICTORY_0067_REMOVAL_ROUTE_CHILD";
+    if std::env::var_os(CHILD).is_some() {
+        fn removed(event: &crate::removal::Removal) -> ! {
+            assert!(
+                crate::removal::enabled(),
+                "flag-off must retain the ordinary failure route"
+            );
+            assert!(
+                event.reason < 0,
+                "the callback must receive the real removal reason"
+            );
+            assert!(event.fault.contains("host GPU removal notification"));
+            // An owned copy survives independently of the device-owned DRED
+            // pointers. Breadcrumb availability itself depends on the runtime.
+            let dred: String = event.dred.clone();
+            assert_eq!(dred, event.dred);
+            std::process::exit(67)
+        }
+        fn failed(_what: &str) -> ! {
+            assert!(
+                !crate::removal::enabled(),
+                "flag-on must route real removal to its callback"
+            );
+            std::process::exit(68)
+        }
+        crate::removal::on_removal(removed);
+        crate::host::on_failure(failed);
+        let host = crate::host::host().expect("the isolated host must create a WARP device");
+        let removable = host
+            .device
+            .cast::<ID3D12Device5>()
+            .expect("ID3D12Device5::RemoveDevice is required");
+        // SAFETY: the child was launched with the diagnostics WARP path; only
+        // its software device is removed, then the production fail path runs.
+        unsafe { removable.RemoveDevice() };
+        if crate::removal::enabled() {
+            // No further submission/present: the event watcher must detect it.
+            std::thread::sleep(Duration::from_secs(10));
+            panic!("removal notification did not run");
+        }
+        crate::host::fail(format_args!("0067 synthetic host removal"));
+    }
+    for (flag, expected) in [("1", 67), ("0", 68)] {
+        let child = Command::new(std::env::current_exe().expect("test executable"))
+            .args([
+                "--exact",
+                "removal_warp_tests::warp_removal_routes_through_host_failure_with_the_flag_on_and_off",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .env("VICTORY_D3D12_WARP", "1")
+            .env("VICTORY_RECOVER_REMOVAL", flag)
+            .spawn().expect("isolated production removal route probe");
+        let mut child = ChildGuard(child);
+        let started = Instant::now();
+        loop {
+            if let Some(status) = child
+                .0
+                .try_wait()
+                .expect("poll production removal route probe")
+            {
+                assert_eq!(
+                    status.code(),
+                    Some(expected),
+                    "unexpected host failure route with flag={flag}"
+                );
+                break;
+            }
+            assert!(
+                started.elapsed() < Duration::from_secs(30),
+                "host removal route timed out with flag={flag}"
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+}
+
+fn probe() {
+    let adapter = crate::host::warp_adapter().expect("WARP is required for this diagnostics test");
+    let budget = crate::removal::AttemptBudget::default();
+    let mut device = make_device(&adapter);
+    for attempt in 1..=3 {
+        // All objects from the current device remain live until after DRED is
+        // queried. Their scope then releases every COM reference before create.
+        {
+            let library = make_library(&device);
+            let heap = make_heap(&device);
+            submit(&device);
+            let removable = device
+                .cast::<ID3D12Device5>()
+                .expect("ID3D12Device5::RemoveDevice is required");
+            // SAFETY: WARP is software, in a disposable process. This does not
+            // provoke a hardware TDR or remove a desktop display adapter.
+            unsafe { removable.RemoveDevice() };
+            let reason = unsafe { device.GetDeviceRemovedReason() }
+                .expect_err("RemoveDevice must be observable through GetDeviceRemovedReason")
+                .code()
+                .0;
+            assert!(crate::removal::is_removal(
+                DXGI_ERROR_DEVICE_REMOVED.0,
+                reason
+            ));
+            assert!(
+                !crate::removal::is_removal(E_FAIL.0, 0),
+                "an ordinary fault must remain ordinary"
+            );
+            if let Ok(dred) = device.cast::<ID3D12DeviceRemovedExtendedData>() {
+                // SAFETY: query while the removed device and all children live.
+                // WARP may not support breadcrumbs; absence is not a skipped
+                // removal/reconstruction test.
+                let _ = unsafe { dred.GetAutoBreadcrumbsOutput() };
+            }
+            assert_eq!(budget.take(), Some(attempt));
+            drop((removable, heap, library));
+        }
+        drop(device);
+        device = make_device(&adapter);
+        // Rebuild the library and heap on the replacement, then prove its
+        // command queue and fence execute instead of only checking creation.
+        let library = make_library(&device);
+        let heap = make_heap(&device);
+        submit(&device);
+        assert!(unsafe { device.GetDeviceRemovedReason() }.is_ok());
+        drop((heap, library));
+    }
+    assert_eq!(
+        budget.take(),
+        None,
+        "a fourth automatic recovery must be refused"
+    );
+    assert_eq!(budget.take(), None, "exhaustion must remain exhausted");
+}
+
+fn make_device(adapter: &windows::Win32::Graphics::Dxgi::IDXGIAdapter) -> ID3D12Device {
+    let mut device = None;
+    // SAFETY: a verified software adapter and an initialized output slot.
+    unsafe { D3D12CreateDevice(adapter, D3D_FEATURE_LEVEL_12_0, &mut device) }
+        .expect("create a fresh WARP device after releasing the removed device");
+    device.expect("D3D12CreateDevice output")
+}
+
+fn make_library(device: &ID3D12Device) -> ID3D12PipelineLibrary {
+    let device1 = device
+        .cast::<ID3D12Device1>()
+        .expect("pipeline library device interface");
+    // SAFETY: an empty blob creates a new library with no borrowed storage.
+    unsafe { device1.CreatePipelineLibrary(&[]) }.expect("recreate WARP pipeline library")
+}
+
+fn make_heap(device: &ID3D12Device) -> ID3D12DescriptorHeap {
+    // SAFETY: a valid one-entry shader-visible descriptor heap description.
+    unsafe {
+        device.CreateDescriptorHeap(&D3D12_DESCRIPTOR_HEAP_DESC {
+            Type: D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,
+            NumDescriptors: 1,
+            Flags: D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,
+            NodeMask: 0,
+        })
+    }
+    .expect("recreate WARP descriptor heap")
+}
+
+fn submit(device: &ID3D12Device) {
+    // SAFETY: all objects belong to this same device and stay live through the
+    // bounded fence wait. The list is closed before execution.
+    unsafe {
+        let queue: ID3D12CommandQueue = device
+            .CreateCommandQueue(&D3D12_COMMAND_QUEUE_DESC {
+                Type: D3D12_COMMAND_LIST_TYPE_DIRECT,
+                ..Default::default()
+            })
+            .expect("replacement queue");
+        let allocator: ID3D12CommandAllocator = device
+            .CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT)
+            .expect("replacement allocator");
+        let list: ID3D12GraphicsCommandList = device
+            .CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, &allocator, None)
+            .expect("replacement list");
+        list.Close().expect("close replacement list");
+        let fence: ID3D12Fence = device
+            .CreateFence(0, D3D12_FENCE_FLAG_NONE)
+            .expect("replacement fence");
+        let event = CreateEventW(None, false, false, None).expect("replacement fence event");
+        queue.ExecuteCommandLists(&[Some(list.cast().expect("executable list"))]);
+        let signalled = queue.Signal(&fence, 1);
+        let armed = fence.SetEventOnCompletion(1, event);
+        let waited = if signalled.is_ok() && armed.is_ok() {
+            WaitForSingleObject(event, 5_000)
+        } else {
+            WAIT_OBJECT_0
+        };
+        let closed = CloseHandle(event);
+        signalled.expect("signal replacement queue");
+        armed.expect("arm replacement fence");
+        closed.expect("close replacement fence event");
+        assert_eq!(
+            waited, WAIT_OBJECT_0,
+            "replacement submission must finish within 5 s"
+        );
+        assert_ne!(
+            fence.GetCompletedValue(),
+            u64::MAX,
+            "device removal is not successful fence completion"
+        );
+        assert!(fence.GetCompletedValue() >= 1);
+    }
+}
