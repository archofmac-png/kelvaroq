+/// Captures cloneable private/image/section RAM before teardown. The archive is
+/// SCARLRAM1, followed by records (base:u64, length:u64, protection:u32, type:u32,
+/// bytes[length]), then an all-zero record. Inaccessible/uncommitted ranges
+/// are excluded; guard protection is removed only in the clone. Read failures abort publication rather than claiming completeness.
+/// Shareable sections may change while copied: forensic data, never a safe point.
+pub fn capture_ram(file: &Path) -> io::Result<u64> {
+    use windows_sys::Win32::System::{
+        Diagnostics::{Debug::ReadProcessMemory, ProcessSnapshotting::*},
+        Memory::*,
+        Threading::GetCurrentProcess,
+    };
+    struct Snapshot(HPSS);
+    impl Drop for Snapshot {
+        fn drop(&mut self) {
+            // SAFETY: this snapshot belongs to our process; no borrowed handle escapes.
+            unsafe {
+                PssFreeSnapshot(GetCurrentProcess(), self.0);
+            }
+        }
+    }
+    let mut snapshot = std::ptr::null_mut();
+    // SAFETY: snapshot output is valid; no title code or DbgHelp is called.
+    let error = unsafe {
+        PssCaptureSnapshot(
+            GetCurrentProcess(),
+            PSS_CAPTURE_VA_CLONE | PSS_CREATE_USE_VM_ALLOCATIONS,
+            0,
+            &mut snapshot,
+        )
+    };
+    if error != 0 {
+        return Err(io::Error::from_raw_os_error(error as i32));
+    }
+    let snapshot = Snapshot(snapshot);
+    let mut clone = PSS_VA_CLONE_INFORMATION::default();
+    // SAFETY: sized clone-information output; snapshot stays alive during reads.
+    let error = unsafe {
+        PssQuerySnapshot(
+            snapshot.0,
+            PSS_QUERY_VA_CLONE_INFORMATION,
+            (&raw mut clone).cast(),
+            size_of_val(&clone) as u32,
+        )
+    };
+    if error != 0 {
+        return Err(io::Error::from_raw_os_error(error as i32));
+    }
+    write_verified(file, |out| {
+        out.write_all(b"SCARLRAM1")?;
+        let mut at = 0usize;
+        let mut buffer = vec![0; 1 << 20];
+        loop {
+            let mut region = MEMORY_BASIC_INFORMATION::default();
+            // SAFETY: query does not dereference the target address in this process.
+            if unsafe {
+                VirtualQueryEx(
+                    clone.VaCloneHandle,
+                    at as *const _,
+                    &mut region,
+                    size_of_val(&region),
+                )
+            } == 0
+            {
+                let e = io::Error::last_os_error();
+                // End of the user VA space; any other query failure is an error.
+                if e.raw_os_error() == Some(87) {
+                    break;
+                }
+                return Err(e);
+            }
+            let base = region.BaseAddress as usize;
+            let end = base
+                .checked_add(region.RegionSize)
+                .filter(|end| *end > at)
+                .ok_or_else(|| invalid("invalid RAM region"))?;
+            if region.State == MEM_COMMIT
+                && region.Protect & PAGE_NOACCESS == 0
+                && region.Protect & 0xff != PAGE_EXECUTE
+                && region.Protect != 0
+            {
+                if region.Protect & PAGE_GUARD != 0 {
+                    let mut old = 0;
+                    // SAFETY: changing this clone's protection cannot disarm the
+                    // live title's write-watch guards. Preserve original flags
+                    // in the archive. Reject failure rather than omit RAM.
+                    if unsafe {
+                        VirtualProtectEx(
+                            clone.VaCloneHandle,
+                            region.BaseAddress,
+                            region.RegionSize,
+                            region.Protect & !PAGE_GUARD,
+                            &mut old,
+                        )
+                    } == 0
+                    {
+                        return Err(io::Error::last_os_error());
+                    }
+                }
+                out.write_all(&(base as u64).to_le_bytes())?;
+                out.write_all(&(region.RegionSize as u64).to_le_bytes())?;
+                out.write_all(&region.Protect.to_le_bytes())?;
+                out.write_all(&region.Type.to_le_bytes())?;
+                let mut cursor = base;
+                while cursor < end {
+                    let n = buffer.len().min(end - cursor);
+                    let mut read = 0;
+                    // SAFETY: OS validates clone memory; output is n writable bytes.
+                    if unsafe {
+                        ReadProcessMemory(
+                            clone.VaCloneHandle,
+                            cursor as *const _,
+                            buffer.as_mut_ptr().cast(),
+                            n,
+                            &mut read,
+                        )
+                    } == 0
+                        || read != n
+                    {
+                        return Err(io::Error::last_os_error());
+                    }
+                    out.write_all(&buffer[..n])?;
+                    cursor += n;
+                }
+            }
+            at = end;
+        }
+        out.write_all(&[0; 24])
+    })
+}
+
+/// JSON string escaping without adding a serialization dependency to the loader.
+pub fn json_string(text: &str) -> String {
+    let mut out = String::from("\"");
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if c < ' ' => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
