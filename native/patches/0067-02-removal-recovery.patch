+//! Immutable forensic recovery generations. These are not executable checkpoints:
+//! lost GPU writes, OS handles and shared pages cannot be rolled back from RAM.
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+fn invalid(what: &str) -> io::Error {
+    io::Error::other(what)
+}
+
+fn hash(file: &Path) -> io::Result<(u64, blake3::Hash)> {
+    let mut input = File::open(file)?;
+    let mut hasher = blake3::Hasher::new();
+    let mut bytes = 0;
+    let mut buffer = vec![0; 1 << 20];
+    loop {
+        let n = input.read(&mut buffer)?;
+        if n == 0 {
+            break;
+        }
+        hasher.update(&buffer[..n]);
+        bytes += n as u64;
+    }
+    Ok((bytes, hasher.finalize()))
+}
+
+/// Writes and flushes a new file, then reopens and hashes every byte. Never
+/// opens an existing destination for truncation, including staging files.
+pub fn write_verified(
+    file: &Path,
+    write: impl FnOnce(&mut dyn Write) -> io::Result<()>,
+) -> io::Result<u64> {
+    struct Checked {
+        file: File,
+        hash: blake3::Hasher,
+        bytes: u64,
+    }
+    impl Write for Checked {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            let n = self.file.write(bytes)?;
+            self.hash.update(&bytes[..n]);
+            self.bytes += n as u64;
+            Ok(n)
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            self.file.flush()
+        }
+    }
+    let mut out = Checked {
+        file: OpenOptions::new().write(true).create_new(true).open(file)?,
+        hash: blake3::Hasher::new(),
+        bytes: 0,
+    };
+    write(&mut out)?;
+    out.file.sync_all()?;
+    let expected = (out.bytes, out.hash.finalize());
+    drop(out);
+    if hash(file)? != expected {
+        return Err(invalid("snapshot read-back mismatch"));
+    }
+    Ok(expected.0)
+}
+
+/// Copy while the caller holds the title's save-operation lock. Links and
+/// junctions are rejected; they could escape the selected state directory.
+pub fn copy_tree(source: &Path, destination: &Path) -> io::Result<()> {
+    use std::os::windows::fs::MetadataExt;
+    let metadata = match fs::symlink_metadata(source) {
+        Ok(m) => m,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => {
+            fs::create_dir(destination)?;
+            return Ok(());
+        }
+        Err(e) => return Err(e),
+    };
+    if metadata.file_attributes() & 0x400 != 0 {
+        return Err(invalid("state contains a reparse point"));
+    }
+    fs::create_dir(destination)?;
+    for entry in fs::read_dir(source)? {
+        let entry = entry?;
+        let metadata = fs::symlink_metadata(entry.path())?;
+        if metadata.file_attributes() & 0x400 != 0 {
+            return Err(invalid("state contains a reparse point"));
+        }
+        let to = destination.join(entry.file_name());
+        if metadata.is_dir() {
+            copy_tree(&entry.path(), &to)?;
+        } else if metadata.is_file() {
+            let mut input = File::open(entry.path())?;
+            write_verified(&to, |out| {
+                io::copy(&mut input, out)?;
+                Ok(())
+            })?;
+        } else {
+            return Err(invalid("state contains a non-file"));
+        }
+    }
+    Ok(())
+}
