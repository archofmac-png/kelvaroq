--- a/crates/victory-gpu/src/removal.rs
+++ b/crates/victory-gpu/src/removal.rs
@@ -21,7 +21,95 @@ pub struct Removal {
     pub fault: String,
 }
 
+/// Recurring removal callbacks exhausted the process-lifetime admission budget.
+pub const RECURRING_REMOVAL_EXIT: u32 = 0xe0680003;
+/// A destructive diagnostics probe tried to enter the live removal callback.
+#[cfg(all(windows, test, feature = "diagnostics"))]
+pub(crate) const PROBE_REENTRY_EXIT: u32 = 0xe0680004;
+
 static REPORT: OnceLock<fn(&Removal) -> !> = OnceLock::new();
+static DISPATCHES: AttemptBudget = AttemptBudget(AtomicU32::new(0));
+static OWNER: AtomicU32 = AtomicU32::new(0);
+
+fn observer_id() -> u32 {
+    #[cfg(windows)]
+    // SAFETY: a plain query; Windows thread ids are nonzero and unique among
+    // live threads. The owner callback diverges and never relinquishes its id.
+    unsafe {
+        windows::Win32::System::Threading::GetCurrentThreadId()
+    }
+    #[cfg(not(windows))]
+    {
+        static NEXT: AtomicU32 = AtomicU32::new(1);
+        thread_local! {
+            static ID: u32 = NEXT.fetch_update(Ordering::Relaxed, Ordering::Relaxed,
+                |id| id.checked_add(1)).unwrap_or_else(|_| terminal(RECURRING_REMOVAL_EXIT));
+        }
+        ID.with(|id| *id)
+    }
+}
+
+fn coalesce_observers() {
+    let me = observer_id();
+    if OWNER
+        .compare_exchange(0, me, Ordering::AcqRel, Ordering::Acquire)
+        .is_err_and(|owner| owner != me)
+    {
+        // Simultaneous submit/present/fence observers describe the same
+        // failure. They cannot consume attempts or terminate the owner while
+        // its helper is capturing RAM. Only recurrence on the owner thread
+        // reaches the budget. The terminal callback never resets ownership.
+        loop {
+            #[cfg(windows)]
+            // SAFETY: park this observer without allocating or taking locks.
+            unsafe {
+                windows::Win32::System::Threading::Sleep(u32::MAX);
+            }
+            #[cfg(not(windows))]
+            std::thread::park();
+        }
+    }
+}
+
+/// Number of admitted production removal callbacks, never reset after dispatch.
+/// These are callback admissions, not proof of a resumed title or GPU replay.
+pub fn dispatch_count() -> u32 {
+    DISPATCHES.0.load(Ordering::Acquire)
+}
+
+#[cfg(all(windows, test, feature = "diagnostics"))]
+static PROBING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// The reconstruction fixture may remove its own device, but cannot re-enter
+/// live removal handling from any thread or consume that path's lifetime cap.
+#[cfg(all(windows, test, feature = "diagnostics"))]
+pub(crate) struct ProbeGuard;
+#[cfg(all(windows, test, feature = "diagnostics"))]
+impl ProbeGuard {
+    pub(crate) fn enter() -> Self {
+        if PROBING.swap(true, Ordering::AcqRel) {
+            terminal(PROBE_REENTRY_EXIT);
+        }
+        Self
+    }
+}
+#[cfg(all(windows, test, feature = "diagnostics"))]
+impl Drop for ProbeGuard {
+    fn drop(&mut self) {
+        PROBING.store(false, Ordering::Release);
+    }
+}
+
+fn terminal(code: u32) -> ! {
+    #[cfg(windows)]
+    // SAFETY: recurring failure is terminal. Do not acquire locks or run title
+    // detach callbacks while another observer may already be preserving RAM.
+    unsafe {
+        use windows::Win32::System::Threading::{GetCurrentProcess, TerminateProcess};
+        let _ = TerminateProcess(GetCurrentProcess(), code);
+    }
+    std::process::exit(code as i32)
+}
 pub fn on_removal(report: fn(&Removal) -> !) {
     let _ = REPORT.set(report);
 }
@@ -30,6 +118,17 @@ pub(crate) fn report(event: &Removal) {
     if enabled()
         && let Some(report) = REPORT.get()
     {
+        #[cfg(all(windows, test, feature = "diagnostics"))]
+        if PROBING.load(Ordering::Acquire) {
+            terminal(PROBE_REENTRY_EXIT);
+        }
+        coalesce_observers();
+        // Recursive owner faults cannot obtain a fourth admission. Normal
+        // title handling terminates on its first admission; this does not
+        // introduce unsafe title reconstruction or replay.
+        if DISPATCHES.take().is_none() {
+            terminal(RECURRING_REMOVAL_EXIT);
+        }
         report(event);
     }
 }
