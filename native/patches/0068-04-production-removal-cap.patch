+/// Exercise recurrence through host::fail after an actual device removal, not
+/// just a local budget or report mock. A fourth dispatch cannot run the callback.
+#[test]
+fn real_removal_dispatch_stops_at_three_and_probe_cannot_reenter() {
+    const CHILD: &str = "VICTORY_0068_REMOVAL_CAP_CHILD";
+    const TEST: &str =
+        "removal_warp_tests::real_removal_dispatch_stops_at_three_and_probe_cannot_reenter";
+    if let Some(root) = std::env::var_os(CHILD) {
+        fn recurring(event: &crate::removal::Removal) -> ! {
+            use std::io::Write;
+            assert!(event.reason < 0);
+            let root = std::path::PathBuf::from(std::env::var_os(CHILD).unwrap());
+            let mut record = std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(root.join("callbacks"))
+                .unwrap();
+            writeln!(record, "{}", crate::removal::dispatch_count()).unwrap();
+            record.sync_all().unwrap();
+            drop(record);
+            if std::env::var_os("VICTORY_0068_CONCURRENT_OBSERVERS").is_some() {
+                use std::sync::{
+                    Arc, Barrier,
+                    atomic::{AtomicU32, Ordering},
+                };
+                assert_eq!(
+                    crate::removal::dispatch_count(),
+                    1,
+                    "only the owner may enter callback"
+                );
+                let release = Arc::new(Barrier::new(9));
+                let entered = Arc::new(AtomicU32::new(0));
+                let (ready, arrivals) = std::sync::mpsc::channel();
+                for _ in 0..8 {
+                    let release = release.clone();
+                    let entered = entered.clone();
+                    let ready = ready.clone();
+                    drop(std::thread::spawn(move || {
+                        ready.send(()).unwrap();
+                        release.wait();
+                        entered.fetch_add(1, Ordering::Release);
+                        crate::host::fail(format_args!("0068 concurrent host removal observer"));
+                    }));
+                }
+                for _ in 0..8 {
+                    arrivals
+                        .recv_timeout(Duration::from_secs(5))
+                        .expect("observer ready");
+                }
+                release.wait();
+                let started = Instant::now();
+                while entered.load(Ordering::Acquire) != 8 {
+                    assert!(
+                        started.elapsed() < Duration::from_secs(5),
+                        "observers did not enter fail"
+                    );
+                    std::thread::sleep(Duration::from_millis(1));
+                }
+                // Give every observer a bounded opportunity to reach the
+                // production dispatch gate. They must park without consuming
+                // admissions or killing the owner's preservation callback.
+                std::thread::sleep(Duration::from_millis(250));
+                assert_eq!(crate::removal::dispatch_count(), 1);
+                assert_eq!(
+                    std::fs::read_to_string(root.join("callbacks")).unwrap(),
+                    "1\n"
+                );
+                std::process::exit(68);
+            }
+            // Re-enter the real host failure route: GetDeviceRemovedReason
+            // still observes the removed device, and every entry must cross
+            // the same production dispatch budget.
+            crate::host::fail(format_args!("0068 recurring host removal"));
+        }
+        crate::removal::on_removal(recurring);
+        let _root = root;
+        if std::env::var_os("VICTORY_0068_PROBE_REENTRY").is_some() {
+            let _probe = crate::removal::ProbeGuard::enter();
+            // A genuine removal in a destructive fixture must not re-enter
+            // the title callback, even while production recovery is enabled.
+            crate::removal::report(&removed_event());
+        } else {
+            let host = crate::host::host().expect("isolated host WARP device");
+            let removable = host
+                .device
+                .cast::<ID3D12Device5>()
+                .expect("RemoveDevice interface");
+            // SAFETY: this child is restricted to the diagnostics WARP adapter.
+            unsafe { removable.RemoveDevice() };
+            std::thread::sleep(Duration::from_secs(10));
+        }
+        panic!("terminal removal dispatch returned");
+    }
+    for (probing, concurrent) in [(false, false), (true, false), (false, true)] {
+        let root = tempfile::tempdir().unwrap();
+        let mut command = Command::new(std::env::current_exe().unwrap());
+        command
+            .args(["--exact", TEST, "--nocapture"])
+            .env(CHILD, root.path())
+            .env("VICTORY_RECOVER_REMOVAL", "1")
+            .env("VICTORY_D3D12_WARP", "1");
+        if probing {
+            command.env("VICTORY_0068_PROBE_REENTRY", "1");
+        } else {
+            command.env_remove("VICTORY_0068_PROBE_REENTRY");
+        }
+        if concurrent {
+            command.env("VICTORY_0068_CONCURRENT_OBSERVERS", "1");
+        } else {
+            command.env_remove("VICTORY_0068_CONCURRENT_OBSERVERS");
+        }
+        let mut child = ChildGuard(command.spawn().unwrap());
+        let started = Instant::now();
+        let status = loop {
+            if let Some(status) = child.0.try_wait().unwrap() {
+                break status;
+            }
+            assert!(
+                started.elapsed() < Duration::from_secs(30),
+                "production cap child timed out"
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        };
+        assert_eq!(
+            status.code().unwrap() as u32,
+            if probing {
+                crate::removal::PROBE_REENTRY_EXIT
+            } else if concurrent {
+                68
+            } else {
+                crate::removal::RECURRING_REMOVAL_EXIT
+            }
+        );
+        if probing {
+            assert!(
+                !root.path().join("callbacks").exists(),
+                "probe must invoke zero title callbacks"
+            );
+        } else {
+            assert_eq!(
+                std::fs::read_to_string(root.path().join("callbacks")).unwrap(),
+                if concurrent { "1\n" } else { "1\n2\n3\n" }
+            );
+        }
+    }
+}
+
+/// Produce a genuine removal event for the forbidden probe reentry test.
+/// All COM references are released before the owned report is returned.
+fn removed_event() -> crate::removal::Removal {
+    let adapter = crate::host::warp_adapter().expect("WARP is required");
+    let device = make_device(&adapter);
+    submit(&device);
+    let removable = device
+        .cast::<ID3D12Device5>()
+        .expect("RemoveDevice interface");
+    // SAFETY: this helper only creates a software device in a disposable child.
+    unsafe { removable.RemoveDevice() };
+    let reason = unsafe { device.GetDeviceRemovedReason() }
+        .expect_err("actual WARP device removal")
+        .code()
+        .0;
+    assert!(crate::removal::is_removal(
+        DXGI_ERROR_DEVICE_REMOVED.0,
+        reason
+    ));
+    crate::removal::Removal {
+        reason,
+        in_flight_commands: None,
+        dred: String::new(),
+        fault: "0068 real recurring WARP removal".into(),
+    }
+}
+
