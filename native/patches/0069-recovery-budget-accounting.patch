+const MIN_BUDGET_MS: u64 = 300;
+const PARENT_MARGIN_MS: u64 = 125;
+const CHILD_MARGIN_MS: u64 = 25;
+const WORK_MARGIN_MS: u64 = 175;
+
+#[derive(Debug)]
+struct Deadlines {
+    work: u64,
+    parent: u64,
+    child: u64,
+}
+impl Deadlines {
+    fn new(started: u64, millis: u64) -> Self {
+        let end = started.saturating_add(millis);
+        Self {
+            work: end.saturating_sub(CHILD_MARGIN_MS + WORK_MARGIN_MS),
+            parent: end.saturating_sub(PARENT_MARGIN_MS),
+            child: end.saturating_sub(CHILD_MARGIN_MS),
+        }
+    }
+}
+fn configured_budget(value: Option<&str>) -> u64 {
+    value
+        .and_then(|v| v.parse::<u64>().ok())
+        .unwrap_or(2000)
+        .clamp(MIN_BUDGET_MS, 10_000)
+}
+fn ticks() -> u64 {
+    let now = unsafe { windows_sys::Win32::System::SystemInformation::GetTickCount64() };
+    #[cfg(test)]
+    if std::env::var_os(CHILD).is_some() {
+        return now.saturating_add_signed(number::<i64>("SCARLETT_0069_CLOCK_SKEW").unwrap_or(0));
+    }
+    now
+}
+fn sleep_until(deadline: u64) {
+    loop {
+        let remaining = deadline.saturating_sub(ticks());
+        if remaining == 0 {
+            return;
+        }
+        unsafe { Sleep(remaining.min(u32::MAX as u64) as u32) };
+    }
+}
 
