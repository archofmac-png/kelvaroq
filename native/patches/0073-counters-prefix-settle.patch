+        assert_eq!(pending.select(&spans(&[]), 0), Plan::None);
+        assert_eq!(
+            pending.select(&spans(&[(20, 30), (60, 70), (15, 15)]), 0),
+            Plan::None
+        );
+    }
+
+    #[test]
+    fn newest_overlap_waits_only_for_that_prefix() {
+        let mut pending = pending();
+        assert_eq!(
+            pending.select(&spans(&[(11, 12), (31, 32)]), 0),
+            Plan::Through(2)
+        );
+        pending.landed(2);
+        assert_eq!(
+            pending.flights.iter().map(|f| f.number).collect::<Vec<_>>(),
+            [3]
+        );
+        assert_eq!(pending.select(&spans(&[(11, 12), (31, 32)]), 2), Plan::None);
+    }
+
+    #[test]
+    fn repeated_flight_or_read_settles_once_and_only_newer_targets_advance() {
+        let mut pending = pending();
+        pending.push(Some(Writes {
+            number: 3,
+            epoch: 0,
+            ranges: spans(&[(50, 60)]),
+        }));
+        let reads = spans(&[(51, 52), (51, 52)]);
+        assert_eq!(pending.select(&reads, 0), Plan::Through(3));
+        assert_eq!(pending.select(&reads, 3), Plan::None);
+        pending.landed(3);
+        assert_eq!(pending.select(&reads, 0), Plan::None);
+    }
+
+    #[test]
+    fn unknown_writes_or_reads_keep_full_settle_reachable() {
+        let mut pending = pending();
+        pending.flights[0].ranges.incomplete = true;
+        pending.incomplete = true;
+        assert_eq!(pending.select(&spans(&[(70, 80)]), 0), Plan::Full);
+        let mut reads = spans(&[]);
+        reads.incomplete = true;
+        assert_eq!(Pending::new().select(&reads, 0), Plan::Full);
+    }
+
+    #[test]
+    fn in_hand_writers_remain_dependencies_until_publication() {
+        let mut pending = pending();
+        // Taking Run(2) out of Line.line does not call landed(2).
+        assert_eq!(pending.select(&spans(&[(31, 32)]), 0), Plan::Through(2));
+        pending.landed(1);
+        assert_eq!(pending.select(&spans(&[(31, 32)]), 0), Plan::Through(2));
+        pending.landed(2);
+        assert_eq!(pending.select(&spans(&[(31, 32)]), 0), Plan::None);
+    }
+
+    #[test]
+    fn changed_mapping_generation_invalidates_private_proofs() {
+        let bytes = Box::new([0u64; 2]);
+        let at = bytes.as_ptr() as usize;
+        let mut pending = Pending::new();
+        pending.push(Some(Writes {
+            number: 1,
+            epoch: crate::watch::mapping_epoch(),
+            ranges: spans(&[(at, at + 8)]),
+        }));
+        let reads = spans(&[(at + 8, at + 16)]);
+        assert_eq!(pending.plan(&reads, 0), Plan::None);
+        crate::watch::invalidate_mapping_proofs();
+        assert_eq!(pending.plan(&reads, 0), Plan::Full);
+    }
+
+    #[test]
+    fn range_overflow_requires_full_settle() {
+        let mut reads = Ranges::default();
+        reads.add(usize::MAX, 1);
+        assert_eq!(pending().select(&reads, 0), Plan::Full);
+    }
+
+    #[test]
+    fn relay_counter_stays_zero_when_the_predicate_is_already_met() {
+        let before = frame_wait::RELAY_WAIT.micros();
+        relay_wait(WHY_READ, |_| true);
+        assert_eq!(frame_wait::RELAY_WAIT.micros(), before);
+    }
+
+    #[cfg(feature = "diagnostics")]
+    #[test]
+    #[ignore = "controlled WARP run: VICTORY_D3D12_WARP=1 VICTORY_PREFIX_SETTLE=1"]
+    fn warp_prefix_lands_a_once_while_disjoint_b_stays_blocked() {
+        assert!(enabled() && relay());
+        frame_wait::start_worker(false);
+        let relay_before = frame_wait::RELAY_WAIT.micros();
+        let host = host().expect("WARP host");
+        settle_now(WHY_SYNC);
+        let mut values = Box::new([0u64; 4]);
+        let address = values.as_mut_ptr() as usize;
+        let gate_a: ID3D12Fence =
+            unsafe { host.device.CreateFence(0, D3D12_FENCE_FLAG_NONE) }.unwrap();
+        let gate_b: ID3D12Fence =
+            unsafe { host.device.CreateFence(0, D3D12_FENCE_FLAG_NONE) }.unwrap();
+        struct Release(ID3D12Fence, ID3D12Fence);
+        impl Drop for Release {
+            fn drop(&mut self) {
+                unsafe {
+                    self.0.Signal(1).unwrap();
+                    self.1.Signal(1).unwrap();
+                }
+            }
+        }
+        let release = Release(gate_a.clone(), gate_b.clone());
+        unsafe { host.queue.Wait(&gate_a, 1) }.unwrap();
+        let a = host.new_list().unwrap();
+        a.defer_write(address as *mut u8, crate::queue::Written::Value(0x1234), 8);
+        a.close();
+        let number_a = host.execute_own(&a, None);
+        unsafe { host.queue.Wait(&gate_b, 1) }.unwrap();
+        let b = host.new_list().unwrap();
+        b.defer_write(
+            (address + 8) as *mut u8,
+            crate::queue::Written::Value(0x5678),
+            8,
+        );
+        b.close();
+        let number_b = host.execute_own(&b, None);
+        assert!(number_b > number_a && number_a > 0);
+        let unrelated = host.new_list().unwrap();
+        unrelated.defer_fill((address + 24) as *mut u8, (address + 16) as *const u8, 8);
+        let reader = host.new_list().unwrap();
+        reader.defer_fill((address + 24) as *mut u8, address as *const u8, 8);
+        let mut submitted = frame_wait::lock(&host.submitted);
+        let mut settled = 0;
+        let before = LATE_STATS[1].load(Ordering::Relaxed);
+        host.settle_reads(
+            &mut submitted,
+            &[&unrelated],
+            &Default::default(),
+            WHY_READ,
+            &mut settled,
+        );
+        assert_eq!(settled, 0);
+        assert_eq!(LATE_STATS[1].load(Ordering::Relaxed), before);
+        drop(submitted);
+        reader.close();
+        std::thread::scope(|scope| {
+            scope.spawn(|| {
+                let started = std::time::Instant::now();
+                while LATE_STATS[1].load(Ordering::Relaxed) == before
+                    && started.elapsed() < std::time::Duration::from_secs(2)
+                {
+                    std::thread::yield_now();
+                }
+                unsafe { gate_a.Signal(1) }.unwrap();
+            });
+            // Exercise submit itself with the same recording named twice.
+            // Legacy line.written is empty: A only has a bottom-of-pipe write.
+            host.execute_late(vec![crate::list::Detached::for_test(reader)], vec![0, 0]);
+        });
+        assert_eq!(
+            unsafe { ((address + 24) as *const u64).read_volatile() },
+            0x1234
+        );
+        assert_eq!(LATE_STATS[1].load(Ordering::Relaxed), before + 1);
+        assert!(frame_wait::RELAY_WAIT.micros() > relay_before);
+        let mut submitted = frame_wait::lock(&host.submitted);
+        settled = number_a;
+        let again = host.new_list().unwrap();
+        again.defer_fill((address + 24) as *mut u8, address as *const u8, 8);
+        host.settle_reads(
+            &mut submitted,
+            &[&again, &again],
+            &Default::default(),
+            WHY_READ,
+            &mut settled,
+        );
+        assert_eq!(LATE_STATS[1].load(Ordering::Relaxed), before + 1);
+        assert!(line().prefix.landed_through < number_b);
+        assert_eq!(unsafe { (address as *const u64).read_volatile() }, 0x1234);
+        assert_eq!(unsafe { ((address + 8) as *const u64).read_volatile() }, 0);
+        drop(release);
+        host.settle(&mut submitted, WHY_SYNC);
+        assert_eq!(&values[..2], &[0x1234, 0x5678]);
+    }
+
+    #[cfg(feature = "diagnostics")]
+    #[test]
+    #[ignore = "controlled WARP run: compare VICTORY_PREFIX_SETTLE=0 and 1"]
+    fn warp_full_settle_has_identical_bytes_in_both_arms() {
+        let host = host().expect("WARP host");
+        settle_now(WHY_SYNC);
+        let mut bytes = Box::new([0u64; 32]);
+        let address = bytes.as_mut_ptr();
+        let a = host.new_list().unwrap();
+        let b = host.new_list().unwrap();
+        for i in 0..32 {
+            let list = if i < 16 { &a } else { &b };
+            list.defer_write(
+                unsafe { address.add(i) }.cast(),
+                crate::queue::Written::Value((i as u64) ^ 0xabc),
+                8,
+            );
+        }
+        a.close();
+        b.close();
+        host.execute_own(&a, None);
+        host.execute_own(&b, None);
+        settle_now(WHY_SYNC);
+        assert_eq!(*bytes, std::array::from_fn(|i| (i as u64) ^ 0xabc));
+        println!("prefix={} bytes={:x?}", enabled(), bytes);
+    }
+}
