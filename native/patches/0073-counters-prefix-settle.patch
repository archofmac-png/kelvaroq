+//! FIFO dependency watermarks. Metadata outlives removal from the relay queue:
+//! a flight stops being a writer only after all of its publications finish.
+
+use super::*;
+
+pub(super) fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_PREFIX_SETTLE").is_some_and(|v| v == "1"))
+}
+
+#[derive(Default)]
+pub(super) struct Ranges {
+    ranges: Vec<(usize, usize)>,
+    envelope: Option<(usize, usize)>,
+    summary_only: bool,
+    incomplete: bool,
+}
+
+impl Ranges {
+    fn add(&mut self, at: usize, bytes: usize) {
+        if bytes == 0 {
+            return;
+        }
+        match at.checked_add(bytes) {
+            Some(end) => {
+                self.envelope = Some(match self.envelope {
+                    Some((a, b)) => (a.min(at), b.max(end)),
+                    None => (at, end),
+                });
+                if !self.summary_only {
+                    self.ranges.push((at, end));
+                }
+            }
+            None => self.incomplete = true,
+        }
+    }
+
+    fn private(&self) -> bool {
+        !self.incomplete
+            && self.ranges.iter().all(|&(a, b)| {
+                a < b
+                    && !crate::remap::overlaps(a, b - a)
+                    && crate::inplace::private_whole(a, b - a)
+            })
+    }
+}
+
+pub(super) struct Writes {
+    number: u64,
+    epoch: u64,
+    ranges: Ranges,
+}
+
+impl Writes {
+    pub(super) fn recording(number: u64, runs: &[&HostList], back: &[Declared]) -> Self {
+        let mut ranges = Ranges::default();
+        for (_, spans) in back {
+            ranges.ranges.extend_from_slice(spans);
+        }
+        for list in runs {
+            let recording = list.deferred();
+            ranges.incomplete |= recording.incomplete_writes;
+            for &(at, _, bytes) in &recording.writes {
+                ranges.add(at, bytes);
+            }
+            for (_, at, [row, rows, pitch]) in &recording.backs {
+                if *row == 0 || *rows == 0 {
+                    continue;
+                }
+                match (rows - 1)
+                    .checked_mul(*pitch)
+                    .and_then(|n| n.checked_add(*row))
+                {
+                    Some(bytes) => ranges.add(*at, bytes),
+                    None => ranges.incomplete = true,
+                }
+            }
+        }
+        let epoch = if let Some(_mapping) = crate::watch::title_memory_reading_now() {
+            ranges.incomplete |= !ranges.private();
+            crate::watch::mapping_epoch()
+        } else {
+            ranges.incomplete = true;
+            crate::watch::mapping_epoch()
+        };
+        Self {
+            number,
+            epoch,
+            ranges,
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Pending {
+    flights: Vec<Writes>,
+    envelope: Option<(usize, usize)>,
+    incomplete: bool,
+    epoch: Option<u64>,
+    pub(super) landed_through: u64,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum Plan {
+    None,
+    Through(u64),
+    Full,
+    Check,
+}
+
+impl Pending {
+    pub(super) const fn new() -> Self {
+        Self {
+            flights: Vec::new(),
+            envelope: None,
+            incomplete: false,
+            epoch: None,
+            landed_through: 0,
+        }
+    }
+
+    pub(super) fn is_empty(&self) -> bool {
+        self.flights.is_empty()
+    }
+
+    pub(super) fn push(&mut self, writes: Option<Writes>) {
+        if let Some(writes) = writes {
+            self.epoch = if self.flights.is_empty() {
+                Some(writes.epoch)
+            } else if self.epoch == Some(writes.epoch) {
+                self.epoch
+            } else {
+                None
+            };
+            self.incomplete |= writes.ranges.incomplete;
+            for &(a, b) in &writes.ranges.ranges {
+                if a >= b {
+                    continue;
+                }
+                self.envelope = Some(match self.envelope {
+                    Some((c, d)) => (a.min(c), b.max(d)),
+                    None => (a, b),
+                });
+            }
+            self.flights.push(writes);
+        }
+    }
+
+    pub(super) fn landed(&mut self, number: u64) {
+        self.landed_through = self.landed_through.max(number);
+        self.flights.retain(|f| f.number > self.landed_through);
+        self.envelope = None;
+        self.incomplete = false;
+        self.epoch = self.flights.first().map(|f| f.epoch);
+        for flight in &self.flights {
+            self.incomplete |= flight.ranges.incomplete;
+            if self.epoch != Some(flight.epoch) {
+                self.epoch = None;
+            }
+            for &(a, b) in &flight.ranges.ranges {
+                if a >= b {
+                    continue;
+                }
+                self.envelope = Some(match self.envelope {
+                    Some((c, d)) => (a.min(c), b.max(d)),
+                    None => (a, b),
+                });
+            }
+        }
+    }
+
+    fn select(&self, reads: &Ranges, settled: u64) -> Plan {
+        // Unknown writers must be checked BEFORE any disjoint-range shortcut.
+        if reads.incomplete || self.incomplete {
+            return Plan::Full;
+        }
+        for flight in self.flights.iter().rev() {
+            if flight.number <= settled.max(self.landed_through) {
+                continue;
+            }
+            if flight
+                .ranges
+                .ranges
+                .iter()
+                .any(|&(a, b)| reads.ranges.iter().any(|&(c, d)| a < d && c < b))
+            {
+                return Plan::Through(flight.number);
+            }
+        }
+        Plan::None
+    }
+
+    pub(super) fn bound_plan(&self, reads: &Ranges) -> Plan {
+        if self.flights.is_empty() {
+            return Plan::None;
+        }
+        if self.incomplete || reads.incomplete {
+            return Plan::Full;
+        }
+        let Some(_mapping) = crate::watch::title_memory_reading_now() else {
+            return Plan::Full;
+        };
+        if self.epoch != Some(crate::watch::mapping_epoch()) {
+            return Plan::Full;
+        }
+        // All producers were proven private and untranslated at this epoch.
+        // An ordinary section reader cannot alias private storage. A logical
+        // remap can, so reject it, including remaps inside the read envelope.
+        let Some((c, d)) = reads.envelope else {
+            return Plan::None;
+        };
+        if crate::remap::overlaps(c, d - c) {
+            return Plan::Full;
+        }
+        let Some((a, b)) = self.envelope else {
+            return Plan::None;
+        };
+        if a >= d || c >= b {
+            Plan::None
+        } else {
+            Plan::Check
+        }
+    }
+
+    pub(super) fn plan(&self, reads: &Ranges, settled: u64) -> Plan {
+        match self.bound_plan(reads) {
+            Plan::Check => self.select(reads, settled),
+            plan => plan,
+        }
+    }
+}
+
+/// The ordinary prepare-time reads, and for a stale refresh the whole span
+/// each shadow may flush (including gaps between recorded views).
+pub(super) fn reads(
+    runs: &[&HostList],
+    gpu_fills: &std::collections::HashSet<usize>,
+    summary_only: bool,
+) -> Ranges {
+    let mut reads = Ranges {
+        summary_only,
+        ..Default::default()
+    };
+    let mut refreshes: Vec<(usize, usize, usize)> = Vec::new();
+    for list in runs {
+        let recording = list.deferred();
+        reads.incomplete |= recording.pool_bound.is_some();
+        for &(_, a, b) in recording.direct.values() {
+            if a <= b {
+                reads.add(a, b - a);
+            } else {
+                reads.incomplete = true;
+            }
+        }
+        for step in &recording.copies {
+            match step {
+                &Step::Copy(dst, src, n) => {
+                    reads.add(src, n);
+                    reads.add(dst, n);
+                }
+                &Step::Fill(dst, src, n, _) => {
+                    if !gpu_fills.contains(&dst) {
+                        reads.add(src, n);
+                    }
+                }
+                Step::Texture(staging) => {
+                    let (at, n) = staging.memory();
+                    reads.add(at, n);
+                }
+                Step::Run(_) | Step::Host(_) => reads.incomplete = true,
+                Step::Refresh(shadow, a, n)
+                | Step::PoolRead(shadow, a, n)
+                | Step::GpuWrite(shadow, a, n) => {
+                    let Some(b) = a.checked_add(*n) else {
+                        reads.incomplete = true;
+                        continue;
+                    };
+                    if summary_only {
+                        reads.add(*a, *n);
+                        continue;
+                    }
+                    let owner = std::sync::Arc::as_ptr(shadow) as usize;
+                    match refreshes.iter_mut().find(|r| r.0 == owner) {
+                        Some(span) => {
+                            span.1 = span.1.min(*a);
+                            span.2 = span.2.max(b);
+                        }
+                        None => refreshes.push((owner, *a, b)),
+                    }
+                }
+            }
+        }
+    }
+    for (_, a, b) in refreshes {
+        reads.add(a, b - a);
+    }
+    reads
+}
+
