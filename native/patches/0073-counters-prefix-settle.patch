 /// Only a contended queue, flight or submission lock starts a timer.
 pub(crate) fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    lock_title(mutex, Block::Value)
+}
+
+pub(crate) fn lock_title<T>(mutex: &Mutex<T>, kind: Block) -> MutexGuard<'_, T> {
     match mutex.try_lock() {
         Ok(guard) => guard,
         Err(TryLockError::Poisoned(e)) => e.into_inner(),
         Err(TryLockError::WouldBlock) => during(Stage::Lock, || {
+            let _blocked = title_block(kind);
             mutex.lock().unwrap_or_else(|e| e.into_inner())
         }),
     }
 }
 
+/// Cumulative nanoseconds: one relaxed add per completed wait, no log resets,
+/// locks or allocation. Convert the total, rather than truncating every wait.
+pub(crate) struct WaitCounter(AtomicU64);
+
+impl WaitCounter {
+    pub(crate) const fn new() -> Self {
+        Self(AtomicU64::new(0))
+    }
+
+    pub(crate) fn micros(&self) -> u64 {
+        self.0.load(Ordering::Relaxed) / 1000
+    }
+
+    pub(crate) fn time(&self) -> Blocked<'_> {
+        Blocked(self, Instant::now())
+    }
+}
+
+pub(crate) struct Blocked<'a>(&'a WaitCounter, Instant);
+impl Drop for Blocked<'_> {
+    fn drop(&mut self) {
+        self.0
+            .0
+            .fetch_add(self.1.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum Block {
+    Pacing,
+    Fence,
+    Value,
+    Releaser,
+}
+static BLOCKED: [WaitCounter; 4] = [const { WaitCounter::new() }; 4];
+
+pub(crate) fn title_block(kind: Block) -> Option<Blocked<'static>> {
+    (WORKER.get().is_none() && !HELPER.get()).then(|| BLOCKED[kind as usize].time())
+}
+
+pub(crate) static RELAY_WAIT: WaitCounter = WaitCounter::new();
+
+pub(crate) fn submit_relay_block() -> Option<Blocked<'static>> {
+    WORKER
+        .get()
+        .is_some_and(|worker| std::ptr::eq(worker, &SUBMIT))
+        .then(|| RELAY_WAIT.time())
+}
+
+pub(crate) fn monitor_blocked(kind: Block) -> u64 {
+    BLOCKED[kind as usize].micros()
+}
+
+#[cfg(test)]
+#[test]
+fn blocked_counters_are_zero_until_a_wait_and_accumulate_without_reset() {
+    let counter = WaitCounter::new();
+    assert_eq!(counter.micros(), 0);
+    let before = monitor_blocked(Block::Releaser);
+    let mutex = Mutex::new(());
+    drop(lock_title(&mutex, Block::Releaser));
+    assert_eq!(monitor_blocked(Block::Releaser), before);
+    std::thread::scope(|scope| {
+        let held = mutex.lock().unwrap();
+        let (send, recv) = std::sync::mpsc::channel();
+        let mutex = &mutex;
+        let waiter = scope.spawn(move || {
+            send.send(()).unwrap();
+            drop(lock_title(mutex, Block::Releaser));
+        });
+        recv.recv().unwrap();
+        std::thread::sleep(Duration::from_millis(5));
+        drop(held);
+        waiter.join().unwrap();
+    });
+    assert!(monitor_blocked(Block::Releaser) > before);
+    {
+        let _wait = counter.time();
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    let first = counter.micros();
+    assert!(first >= 2000);
+    assert_eq!(counter.micros(), first);
+    {
+        let _wait = counter.time();
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    assert!(counter.micros() >= first + 2000);
+}
