+//! Pruning the launcher's snapshots.
+//!
+//! The launcher keeps snapshots in `<data_dir>/snapshots`: each is an archive
+//! with sidecar files beside it. A snapshot is one *group*: every file whose
+//! name shares the part before its first `.` (`x.zip`, `x.zip.sha256`,
+//! `x.json` are the group `x`), so an archive and its sidecars go together.
+//!
+//! [`prune`] is for after a *successful* restore only. It keeps the newest
+//! [`KEEP_SNAPSHOTS`] groups, never removes the newest, and never removes the
+//! snapshot just restored from.
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+use std::time::SystemTime;
+
+/// Snapshots kept by [`prune`]: the newest, the one restored from, and a few
+/// earlier ones, so a bad restore can be stepped back past a generation or
+/// two without letting the folder grow for ever. Five.
+pub const KEEP_SNAPSHOTS: usize = 5;
+
+/// The folder under the data directory that holds snapshots.
+pub fn snapshots_dir(data_dir: &Path) -> PathBuf {
+    data_dir.join("snapshots")
+}
+
+fn group_of(name: &str) -> &str {
+    name.split_once('.').map_or(name, |(stem, _)| stem)
+}
+
+/// Removes all but the newest `keep` snapshot groups from `dir` (at least
+/// one is always kept, whatever `keep` says) and returns the files removed.
+///
+/// A group's age is its newest file's modification time, ties broken by
+/// name, so the order is the same on every run. `restored` (a path, or just
+/// a file name, inside `dir`) protects its group even if it is old. Only
+/// files are touched: sub-directories and files with no name stem are left.
+/// Call this only after a restore has succeeded. A missing `dir` is nothing
+/// to prune.
+pub fn prune(dir: &Path, keep: usize, restored: Option<&Path>) -> io::Result<Vec<PathBuf>> {
+    let entries = match fs::read_dir(dir) {
+        Ok(e) => e,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(e) => return Err(e),
+    };
+    // group -> (newest mtime, files)
+    let mut groups: BTreeMap<String, (SystemTime, Vec<PathBuf>)> = BTreeMap::new();
+    for entry in entries {
+        let entry = entry?;
+        if !entry.file_type()?.is_file() {
+            continue;
+        }
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let group = group_of(&name);
+        if group.is_empty() {
+            continue;
+        }
+        let modified = entry.metadata()?.modified()?;
+        let slot = groups
+            .entry(group.to_owned())
+            .or_insert((SystemTime::UNIX_EPOCH, Vec::new()));
+        slot.0 = slot.0.max(modified);
+        slot.1.push(entry.path());
+    }
+    let protected = restored
+        .and_then(Path::file_name)
+        .map(|n| group_of(&n.to_string_lossy()).to_owned());
+
+    // Newest first; the name breaks ties.
+    let mut order: Vec<(String, (SystemTime, Vec<PathBuf>))> = groups.into_iter().collect();
+    order.sort_by(|a, b| b.1.0.cmp(&a.1.0).then_with(|| b.0.cmp(&a.0)));
+
+    let mut removed = Vec::new();
+    for (group, (_, files)) in order.into_iter().skip(keep.max(1)) {
+        if protected.as_deref() == Some(group.as_str()) {
+            continue;
+        }
+        for file in files {
+            fs::remove_file(&file)?;
+            removed.push(file);
+        }
+    }
+    removed.sort();
+    Ok(removed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    /// Writes `name` with a modification time `age` seconds in the past.
+    fn put(dir: &Path, name: &str, age: u64) {
+        let p = dir.join(name);
+        fs::write(&p, name).unwrap();
+        let t = SystemTime::now() - Duration::from_secs(age);
+        fs::File::options()
+            .write(true)
+            .open(&p)
+            .unwrap()
+            .set_modified(t)
+            .unwrap();
+    }
+
+    fn names(dir: &Path) -> Vec<String> {
+        let mut v: Vec<_> = fs::read_dir(dir)
+            .unwrap()
+            .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+            .collect();
+        v.sort();
+        v
+    }
+
+    #[test]
+    fn keeps_the_newest_and_removes_older_archives_with_their_sidecars() {
+        let dir = tempfile::tempdir().unwrap();
+        for (stem, age) in [("s1", 400), ("s2", 300), ("s3", 200), ("s4", 100)] {
+            put(dir.path(), &format!("{stem}.zip"), age);
+            put(dir.path(), &format!("{stem}.zip.sha256"), age);
+            put(dir.path(), &format!("{stem}.json"), age);
+        }
+        let removed = prune(dir.path(), 2, None).unwrap();
+        assert_eq!(removed.len(), 6);
+        assert_eq!(
+            names(dir.path()),
+            [
+                "s3.json",
+                "s3.zip",
+                "s3.zip.sha256",
+                "s4.json",
+                "s4.zip",
+                "s4.zip.sha256"
+            ]
+        );
+    }
+
+    #[test]
+    fn the_newest_is_never_pruned_even_when_asked_to_keep_none() {
+        let dir = tempfile::tempdir().unwrap();
+        put(dir.path(), "old.zip", 500);
+        put(dir.path(), "new.zip", 5);
+        put(dir.path(), "new.zip.sha256", 5);
+        prune(dir.path(), 0, None).unwrap();
+        assert_eq!(names(dir.path()), ["new.zip", "new.zip.sha256"]);
+    }
+
+    #[test]
+    fn the_snapshot_restored_from_survives_even_if_old() {
+        let dir = tempfile::tempdir().unwrap();
+        put(dir.path(), "a.zip", 900);
+        put(dir.path(), "a.zip.sha256", 900);
+        put(dir.path(), "b.zip", 300);
+        put(dir.path(), "c.zip", 100);
+        put(dir.path(), "d.zip", 10);
+        prune(dir.path(), 1, Some(&dir.path().join("a.zip"))).unwrap();
+        assert_eq!(names(dir.path()), ["a.zip", "a.zip.sha256", "d.zip"]);
+    }
+
+    #[test]
+    fn under_the_cap_nothing_is_removed() {
+        let dir = tempfile::tempdir().unwrap();
+        for i in 0..KEEP_SNAPSHOTS {
+            put(dir.path(), &format!("s{i}.zip"), 10 * (i as u64 + 1));
+        }
+        assert!(prune(dir.path(), KEEP_SNAPSHOTS, None).unwrap().is_empty());
+        assert_eq!(names(dir.path()).len(), KEEP_SNAPSHOTS);
+    }
+
+    #[test]
+    fn equal_ages_are_broken_by_name_so_the_result_is_stable() {
+        let dir = tempfile::tempdir().unwrap();
+        let t = SystemTime::now() - Duration::from_secs(60);
+        for n in ["a.zip", "b.zip", "c.zip"] {
+            let p = dir.path().join(n);
+            fs::write(&p, n).unwrap();
+            fs::File::options()
+                .write(true)
+                .open(&p)
+                .unwrap()
+                .set_modified(t)
+                .unwrap();
+        }
+        prune(dir.path(), 1, None).unwrap();
+        assert_eq!(names(dir.path()), ["c.zip"]);
+    }
+
+    #[test]
+    fn directories_and_a_missing_folder_are_left_alone() {
+        let dir = tempfile::tempdir().unwrap();
+        fs::create_dir(dir.path().join("nested")).unwrap();
+        fs::write(dir.path().join("nested").join("f"), "x").unwrap();
+        put(dir.path(), "a.zip", 50);
+        put(dir.path(), "b.zip", 10);
+        prune(dir.path(), 1, None).unwrap();
+        assert_eq!(names(dir.path()), ["b.zip", "nested"]);
+        assert!(prune(&dir.path().join("none"), 1, None).unwrap().is_empty());
+    }
+
+    #[test]
+    fn the_folder_is_under_the_data_dir() {
+        assert_eq!(
+            snapshots_dir(Path::new("d")),
+            Path::new("d").join("snapshots")
+        );
+    }
+}
