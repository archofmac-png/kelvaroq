@@ -0,0 +1,533 @@
+//! Interrupted data-directory moves, found from the launcher's markers.
+//!
+//! The launcher moves the data directory in steps. Before it starts it writes
+//! a marker, `<parent>/.kelvaroq-<guid>.move`: UTF-8 JSON with the string
+//! keys `source`, `destination`, `stage` and `step`, flushed to disk, and it
+//! re-writes `step` as it goes. `step` is one of [`STEPS`], in order. Just
+//! before `Directory.Move(stage, destination)` it writes `flip`, so `flip`
+//! means the destination is in place. A crash leaves the last step reached.
+//!
+//! At startup [`scan`] looks in the data directory's parent for `*.move`:
+//!
+//! * a step before `flip`: a real interrupted move; reported with its step,
+//!   stage, destination and source;
+//! * `flip` (or the `verify-source` that follows it): the move completed and
+//!   the marker is stale; reported as such;
+//! * anything that does not parse: reported with its path.
+//!
+//! Nothing is ever changed or deleted here; the report is the whole effect.
+
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+/// The launcher's steps, in the order it reaches them.
+pub const STEPS: [&str; 6] = [
+    "verify-destination",
+    "write-marker",
+    "copy",
+    "verify-checksums",
+    "flip",
+    "verify-source",
+];
+
+/// Index of `flip` in [`STEPS`]: from here on the destination is in place.
+const FLIP: usize = 4;
+
+/// A parsed marker.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Marker {
+    /// The marker file itself.
+    pub path: PathBuf,
+    pub source: String,
+    pub destination: String,
+    pub stage: String,
+    /// One of [`STEPS`].
+    pub step: String,
+}
+
+/// What one `*.move` file means.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Finding {
+    /// The move stopped before `flip`.
+    Interrupted(Marker),
+    /// The move completed; the marker was left behind.
+    Stale(Marker),
+    /// The file is not a marker this code understands.
+    Unparseable { path: PathBuf, reason: String },
+}
+
+impl Finding {
+    /// One line for the log or console.
+    pub fn describe(&self) -> String {
+        match self {
+            Finding::Interrupted(m) => format!(
+                "interrupted data move: stopped at step {} (stage {}, destination {}, source {}); marker {} and everything it names are left untouched",
+                m.step,
+                m.stage,
+                m.destination,
+                m.source,
+                m.path.display()
+            ),
+            Finding::Stale(m) => format!(
+                "stale move marker {}: the move to {} completed (step {}); it can be removed",
+                m.path.display(),
+                m.destination,
+                m.step
+            ),
+            Finding::Unparseable { path, reason } => format!(
+                "unreadable move marker {}: {reason}; left in place",
+                path.display()
+            ),
+        }
+    }
+}
+
+/// Reads every `*.move` beside `data_dir` (in its parent), in path order. A
+/// missing parent has no markers. Files are only read.
+pub fn scan(data_dir: &Path) -> io::Result<Vec<Finding>> {
+    let parent = match data_dir.parent() {
+        Some(p) if p.as_os_str().is_empty() => Path::new("."),
+        Some(p) => p,
+        None => return Ok(Vec::new()),
+    };
+    let entries = match fs::read_dir(parent) {
+        Ok(e) => e,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(e) => return Err(e),
+    };
+    let mut paths = Vec::new();
+    for entry in entries {
+        let path = entry?.path();
+        let is_move = path
+            .extension()
+            .is_some_and(|e| e.eq_ignore_ascii_case("move"));
+        if is_move && path.is_file() {
+            paths.push(path);
+        }
+    }
+    paths.sort();
+    Ok(paths
+        .into_iter()
+        .map(|path| match fs::read(&path) {
+            Err(e) => Finding::Unparseable {
+                reason: format!("cannot read it: {e}"),
+                path,
+            },
+            Ok(bytes) => match parse(&path, &bytes) {
+                Ok(m) if step_index(&m.step) >= Some(FLIP) => Finding::Stale(m),
+                Ok(m) => Finding::Interrupted(m),
+                Err(reason) => Finding::Unparseable { path, reason },
+            },
+        })
+        .collect())
+}
+
+/// The lines to show at startup for `data_dir`: one per finding, or one line
+/// if the scan itself failed. Empty when there is nothing to say.
+pub fn startup_report(data_dir: &Path) -> Vec<String> {
+    match scan(data_dir) {
+        Ok(findings) => findings.iter().map(Finding::describe).collect(),
+        Err(e) => vec![format!(
+            "cannot scan {} for move markers: {e}",
+            data_dir.parent().unwrap_or(data_dir).display()
+        )],
+    }
+}
+
+fn step_index(step: &str) -> Option<usize> {
+    STEPS.iter().position(|s| *s == step)
+}
+
+/// Parses a marker's bytes; the error says why it is not one.
+pub fn parse(path: &Path, bytes: &[u8]) -> Result<Marker, String> {
+    let text = std::str::from_utf8(bytes).map_err(|_| "not valid UTF-8".to_owned())?;
+    let text = text.strip_prefix('\u{feff}').unwrap_or(text);
+    let mut p = Parser { s: text, i: 0 };
+    p.ws();
+    let fields = p.object(0)?;
+    p.ws();
+    if p.i != text.len() {
+        return Err("text after the JSON object".to_owned());
+    }
+    let get = |key: &str| -> Result<String, String> {
+        match fields.iter().rev().find(|(k, _)| k == key) {
+            None => Err(format!("missing key \"{key}\"")),
+            Some((_, Some(v))) => Ok(v.clone()),
+            Some((_, None)) => Err(format!("key \"{key}\" is not a string")),
+        }
+    };
+    let step = get("step")?;
+    if step_index(&step).is_none() {
+        return Err(format!("unknown step \"{step}\""));
+    }
+    Ok(Marker {
+        path: path.to_owned(),
+        source: get("source")?,
+        destination: get("destination")?,
+        stage: get("stage")?,
+        step,
+    })
+}
+
+/// A small strict JSON reader: enough to find string-valued keys in one
+/// object and skip anything else. (No JSON crate is a dependency here.)
+struct Parser<'a> {
+    s: &'a str,
+    i: usize,
+}
+
+/// Nesting beyond this is refused, so a hostile file cannot recurse deeply.
+const MAX_DEPTH: usize = 16;
+
+impl Parser<'_> {
+    fn peek(&self) -> Option<char> {
+        self.s[self.i..].chars().next()
+    }
+
+    fn ws(&mut self) {
+        while matches!(self.peek(), Some(' ' | '\t' | '\n' | '\r')) {
+            self.i += 1;
+        }
+    }
+
+    fn eat(&mut self, want: char) -> Result<(), String> {
+        match self.peek() {
+            Some(c) if c == want => {
+                self.i += c.len_utf8();
+                Ok(())
+            }
+            Some(c) => Err(format!(
+                "expected '{want}' but found '{c}' at byte {}",
+                self.i
+            )),
+            None => Err(format!("expected '{want}' but the text ends")),
+        }
+    }
+
+    fn hex4(&mut self) -> Result<u32, String> {
+        let end = self.i + 4;
+        let digits = self
+            .s
+            .get(self.i..end)
+            .filter(|d| d.bytes().all(|b| b.is_ascii_hexdigit()))
+            .ok_or("bad \\u escape")?;
+        self.i = end;
+        u32::from_str_radix(digits, 16).map_err(|_| "bad \\u escape".to_owned())
+    }
+
+    fn string(&mut self) -> Result<String, String> {
+        self.eat('"')?;
+        let mut out = String::new();
+        loop {
+            let c = self.peek().ok_or("unterminated string")?;
+            self.i += c.len_utf8();
+            match c {
+                '"' => return Ok(out),
+                '\\' => {
+                    let e = self.peek().ok_or("unterminated string")?;
+                    self.i += e.len_utf8();
+                    match e {
+                        '"' | '\\' | '/' => out.push(e),
+                        'b' => out.push('\u{8}'),
+                        'f' => out.push('\u{c}'),
+                        'n' => out.push('\n'),
+                        'r' => out.push('\r'),
+                        't' => out.push('\t'),
+                        'u' => {
+                            let hi = self.hex4()?;
+                            let code = if (0xD800..0xDC00).contains(&hi) {
+                                if !self.s[self.i..].starts_with("\\u") {
+                                    return Err("lone surrogate in a \\u escape".to_owned());
+                                }
+                                self.i += 2;
+                                let lo = self.hex4()?;
+                                if !(0xDC00..0xE000).contains(&lo) {
+                                    return Err("lone surrogate in a \\u escape".to_owned());
+                                }
+                                0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
+                            } else {
+                                hi
+                            };
+                            out.push(char::from_u32(code).ok_or("lone surrogate in a \\u escape")?);
+                        }
+                        other => return Err(format!("bad escape '\\{other}'")),
+                    }
+                }
+                c if (c as u32) < 0x20 => return Err("control character in a string".to_owned()),
+                c => out.push(c),
+            }
+        }
+    }
+
+    /// A value; `Some` if it is a string, `None` for anything else.
+    fn value(&mut self, depth: usize) -> Result<Option<String>, String> {
+        if depth > MAX_DEPTH {
+            return Err("nested too deeply".to_owned());
+        }
+        match self.peek() {
+            Some('"') => self.string().map(Some),
+            Some('{') => self.object(depth + 1).map(|_| None),
+            Some('[') => {
+                self.eat('[')?;
+                self.ws();
+                if self.peek() == Some(']') {
+                    self.i += 1;
+                    return Ok(None);
+                }
+                loop {
+                    self.ws();
+                    self.value(depth + 1)?;
+                    self.ws();
+                    match self.peek() {
+                        Some(',') => self.i += 1,
+                        Some(']') => {
+                            self.i += 1;
+                            return Ok(None);
+                        }
+                        _ => return Err("expected ',' or ']'".to_owned()),
+                    }
+                }
+            }
+            Some(_) => {
+                let start = self.i;
+                while self
+                    .peek()
+                    .is_some_and(|c| !matches!(c, ',' | '}' | ']' | ' ' | '\t' | '\n' | '\r'))
+                {
+                    self.i += self.peek().map_or(1, char::len_utf8);
+                }
+                let token = &self.s[start..self.i];
+                let ok = matches!(token, "true" | "false" | "null") || token.parse::<f64>().is_ok();
+                if ok {
+                    Ok(None)
+                } else {
+                    Err(format!("unexpected value `{token}`"))
+                }
+            }
+            None => Err("the text ends where a value should be".to_owned()),
+        }
+    }
+
+    fn object(&mut self, depth: usize) -> Result<Vec<(String, Option<String>)>, String> {
+        if depth > MAX_DEPTH {
+            return Err("nested too deeply".to_owned());
+        }
+        self.ws();
+        self.eat('{').map_err(|_| "not a JSON object".to_owned())?;
+        let mut fields = Vec::new();
+        self.ws();
+        if self.peek() == Some('}') {
+            self.i += 1;
+            return Ok(fields);
+        }
+        loop {
+            self.ws();
+            let key = self.string()?;
+            self.ws();
+            self.eat(':')?;
+            self.ws();
+            let value = self.value(depth)?;
+            fields.push((key, value));
+            self.ws();
+            match self.peek() {
+                Some(',') => self.i += 1,
+                Some('}') => {
+                    self.i += 1;
+                    return Ok(fields);
+                }
+                _ => return Err("expected ',' or '}'".to_owned()),
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn marker_json(step: &str) -> String {
+        format!(
+            "{{\"source\":\"C:\\\\Old\\\\data\",\"destination\":\"D:\\\\New\\\\data\",\"stage\":\"D:\\\\New\\\\.kelvaroq-stage\",\"step\":\"{step}\"}}"
+        )
+    }
+
+    /// `<root>/data` is the data dir; markers go beside it, in `<root>`.
+    fn setup() -> (tempfile::TempDir, PathBuf) {
+        let root = tempfile::tempdir().unwrap();
+        let data = root.path().join("data");
+        fs::create_dir(&data).unwrap();
+        (root, data)
+    }
+
+    fn put(root: &tempfile::TempDir, name: &str, body: &[u8]) -> PathBuf {
+        let p = root.path().join(name);
+        fs::write(&p, body).unwrap();
+        p
+    }
+
+    #[test]
+    fn every_step_before_flip_is_an_interrupted_move_with_its_fields() {
+        for step in &STEPS[..FLIP] {
+            let (root, data) = setup();
+            let path = put(&root, ".kelvaroq-1.move", marker_json(step).as_bytes());
+            let found = scan(&data).unwrap();
+            assert_eq!(
+                found,
+                vec![Finding::Interrupted(Marker {
+                    path,
+                    source: "C:\\Old\\data".into(),
+                    destination: "D:\\New\\data".into(),
+                    stage: "D:\\New\\.kelvaroq-stage".into(),
+                    step: (*step).into(),
+                })],
+                "step {step}"
+            );
+        }
+    }
+
+    #[test]
+    fn flip_is_stale() {
+        let (root, data) = setup();
+        put(&root, ".kelvaroq-1.move", marker_json("flip").as_bytes());
+        assert!(matches!(scan(&data).unwrap()[..], [Finding::Stale(_)]));
+    }
+
+    #[test]
+    fn verify_source_comes_after_flip_so_it_is_stale_too() {
+        let (root, data) = setup();
+        put(
+            &root,
+            ".kelvaroq-1.move",
+            marker_json("verify-source").as_bytes(),
+        );
+        assert!(matches!(scan(&data).unwrap()[..], [Finding::Stale(_)]));
+    }
+
+    #[test]
+    fn unparseable_markers_are_reported_with_their_path_and_kept() {
+        let bad: [(&str, &[u8]); 8] = [
+            ("empty", b""),
+            ("garbage", b"not json"),
+            ("array", b"[1,2]"),
+            ("missing", b"{\"step\":\"copy\"}"),
+            (
+                "not-string",
+                b"{\"source\":1,\"destination\":\"d\",\"stage\":\"s\",\"step\":\"copy\"}",
+            ),
+            (
+                "unknown-step",
+                br#"{"source":"a","destination":"b","stage":"c","step":"teleport"}"#,
+            ),
+            (
+                "trailing",
+                br#"{"source":"a","destination":"b","stage":"c","step":"copy"} x"#,
+            ),
+            ("not-utf8", &[0xff, 0xfe, 0x00, 0x7b]),
+        ];
+        for (name, body) in bad {
+            let (root, data) = setup();
+            let path = put(&root, &format!(".kelvaroq-{name}.move"), body);
+            let found = scan(&data).unwrap();
+            match &found[..] {
+                [Finding::Unparseable { path: p, reason }] => {
+                    assert_eq!(p, &path, "{name}");
+                    assert!(!reason.is_empty(), "{name}");
+                }
+                other => panic!("{name}: {other:?}"),
+            }
+            assert!(
+                found[0].describe().contains(&path.display().to_string()),
+                "{name}"
+            );
+            assert_eq!(
+                fs::read(&path).unwrap(),
+                body,
+                "{name}: must not be touched"
+            );
+        }
+    }
+
+    #[test]
+    fn scanning_changes_nothing() {
+        let (root, data) = setup();
+        let a = put(&root, ".kelvaroq-a.move", marker_json("copy").as_bytes());
+        let b = put(&root, ".kelvaroq-b.move", marker_json("flip").as_bytes());
+        let c = put(&root, ".kelvaroq-c.move", b"junk");
+        let before: Vec<_> = [&a, &b, &c].iter().map(|p| fs::read(p).unwrap()).collect();
+        scan(&data).unwrap();
+        let after: Vec<_> = [&a, &b, &c].iter().map(|p| fs::read(p).unwrap()).collect();
+        assert_eq!(before, after);
+        assert_eq!(
+            fs::read_dir(root.path()).unwrap().count(),
+            4,
+            "data + 3 markers"
+        );
+    }
+
+    #[test]
+    fn other_files_and_directories_are_ignored_and_findings_come_in_path_order() {
+        let (root, data) = setup();
+        put(&root, "notes.txt", b"hello");
+        put(&root, ".kelvaroq-stage-only", b"{}");
+        fs::create_dir(root.path().join("dir.move")).unwrap();
+        let b = put(&root, ".kelvaroq-b.move", marker_json("copy").as_bytes());
+        let a = put(&root, ".kelvaroq-a.move", marker_json("flip").as_bytes());
+        let paths: Vec<_> = scan(&data)
+            .unwrap()
+            .iter()
+            .map(|f| match f {
+                Finding::Interrupted(m) | Finding::Stale(m) => m.path.clone(),
+                Finding::Unparseable { path, .. } => path.clone(),
+            })
+            .collect();
+        assert_eq!(paths, vec![a, b]);
+    }
+
+    #[test]
+    fn a_missing_parent_or_no_markers_is_quiet() {
+        let (_root, data) = setup();
+        assert!(scan(&data).unwrap().is_empty());
+        assert!(startup_report(&data).is_empty());
+        let gone = data.join("a").join("b");
+        assert!(scan(&gone).unwrap().is_empty());
+    }
+
+    #[test]
+    fn the_report_names_step_stage_destination_and_source() {
+        let (root, data) = setup();
+        put(
+            &root,
+            ".kelvaroq-1.move",
+            marker_json("verify-checksums").as_bytes(),
+        );
+        let lines = startup_report(&data);
+        assert_eq!(lines.len(), 1);
+        for want in [
+            "verify-checksums",
+            "D:\\New\\.kelvaroq-stage",
+            "D:\\New\\data",
+            "C:\\Old\\data",
+        ] {
+            assert!(lines[0].contains(want), "{want} missing from {}", lines[0]);
+        }
+    }
+
+    #[test]
+    fn json_escapes_bom_extra_keys_and_whitespace_are_understood() {
+        let body = "\u{feff} {\n \"extra\": {\"n\": [1, 2.5e3, true, null, \"x\"]},\n\
+            \"source\" : \"a\\/b\\u0041\\ud83d\\ude00\",\n \"destination\":\"d\",\n\
+            \"stage\":\"s\", \"step\":\"copy\", \"n\": -1 }\n";
+        let m = parse(Path::new("m.move"), body.as_bytes()).unwrap();
+        assert_eq!(m.source, "a/bA\u{1F600}");
+        assert_eq!(m.step, "copy");
+    }
+
+    #[test]
+    fn a_lone_surrogate_and_runaway_nesting_are_unparseable() {
+        let lone = br#"{"source":"\ud83d","destination":"d","stage":"s","step":"copy"}"#;
+        assert!(parse(Path::new("m"), lone).is_err());
+        let deep = format!("{{\"x\":{}1{}}}", "[".repeat(100), "]".repeat(100));
+        assert!(parse(Path::new("m"), deep.as_bytes()).is_err());
+    }
+}
