index 0000000..86d85b8
--- /dev/null
+++ b/crates/victory-loader/src/crash_log.rs
@@ -0,0 +1,274 @@
+//! The crash log file: one lock over every writer, and size-capped rotation.
+//!
+//! Two writers append to the log (the free-form report and the one-line JSON
+//! event). Both go through [`append`], which holds [`LOCK`] for the whole
+//! open, length check, rotation and write, so two writers never interleave
+//! and a rotation only ever happens at an append boundary: between records,
+//! never inside one.
+//!
+//! Rotation happens at two points:
+//!
+//! * at startup, before any writer exists ([`rotate_if_over`] from
+//!   `log_crashes_to`), so a previous session's oversized log is moved aside
+//!   before this session owns the file;
+//! * on append, when the live file is already over the cap, inside the lock.
+//!
+//! Rotation shifts `crashes.log` to `crashes.log.1`, `.1` to `.2`, and so on,
+//! and drops the oldest. It is portable (no Windows calls) so it is tested
+//! on its own.
+
+use std::fs::{self, OpenOptions};
+use std::io::{self, Write};
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, TryLockError};
+use std::time::{Duration, Instant};
+
+/// The live log may grow past this before the next append rotates it. A
+/// record is never split, so the file can exceed the cap by one record. 4 MiB
+/// holds many reports (each is a few hundred bytes plus the title's last
+/// eight lines) without a crash loop filling the disk.
+pub(crate) const MAX_LOG_BYTES: u64 = 4 << 20;
+
+/// Rotated files kept (`.1` is the newest). Three generations keep the last
+/// few crashing sessions readable and bound the total to about 16 MiB.
+pub(crate) const KEPT_GENERATIONS: u32 = 3;
+
+/// How long an append waits for another writer. A crash can strike while this
+/// thread already holds the lock (a panic inside a write reaches the panic
+/// hook, which writes again), so waiting forever could hang the crash report.
+const LOCK_WAIT: Duration = Duration::from_millis(250);
+
+/// Held by whoever is writing the log.
+static LOCK: Mutex<()> = Mutex::new(());
+
+fn generation(file: &Path, n: u32) -> PathBuf {
+    let mut name = file.as_os_str().to_owned();
+    name.push(format!(".{n}"));
+    PathBuf::from(name)
+}
+
+fn rename_if_present(from: &Path, to: &Path) -> io::Result<()> {
+    match fs::rename(from, to) {
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
+        other => other,
+    }
+}
+
+/// Moves `file` to `file.1`, shifting older generations up and deleting the
+/// one that would pass `generations`. With `generations == 0` the file is
+/// simply deleted.
+pub(crate) fn rotate(file: &Path, generations: u32) -> io::Result<()> {
+    if generations == 0 {
+        return match fs::remove_file(file) {
+            Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
+            other => other,
+        };
+    }
+    match fs::remove_file(generation(file, generations)) {
+        Err(e) if e.kind() != io::ErrorKind::NotFound => return Err(e),
+        _ => {}
+    }
+    for n in (1..generations).rev() {
+        rename_if_present(&generation(file, n), &generation(file, n + 1))?;
+    }
+    rename_if_present(file, &generation(file, 1))
+}
+
+/// Rotates `file` if it is longer than `cap`; says whether it did. A missing
+/// file is not over the cap.
+pub(crate) fn rotate_if_over(
+    file: &Path,
+    cap: u64,
+    generations: u32,
+    incoming: u64,
+) -> io::Result<bool> {
+    // Rotate before the record that would cross the cap, so no generation exceeds it and the
+    // record that triggers rotation is the first thing in the new live file.
+    match fs::metadata(file) {
+        Ok(m) if m.len() > 0 && m.len() + incoming > cap => {
+            rotate(file, generations).map(|()| true)
+        }
+        Ok(_) => Ok(false),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(e) => Err(e),
+    }
+}
+
+/// Takes [`LOCK`], waiting up to [`LOCK_WAIT`]; `None` if it stays held. A
+/// poisoned lock is still a lock: a writer that panicked left no state in it.
+fn lock() -> Option<std::sync::MutexGuard<'static, ()>> {
+    let start = Instant::now();
+    loop {
+        match LOCK.try_lock() {
+            Ok(g) => return Some(g),
+            Err(TryLockError::Poisoned(p)) => return Some(p.into_inner()),
+            Err(TryLockError::WouldBlock) if start.elapsed() < LOCK_WAIT => {
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            Err(TryLockError::WouldBlock) => return None,
+        }
+    }
+}
+
+/// Appends `record` (already complete, newline included) to `file`.
+///
+/// Under the lock: if the live file is over `cap` it is rotated first (best
+/// effort: a rotation that fails, say because a reader holds the file, must
+/// not lose the record), then the record is written in one call. `sync`
+/// flushes it to disk before returning. If the lock cannot be had in time the
+/// record is still appended, without rotating, since a report that is
+/// written beats one that waits.
+pub(crate) fn append(
+    file: &Path,
+    cap: u64,
+    generations: u32,
+    record: &[u8],
+    sync: bool,
+) -> io::Result<()> {
+    let _guard = lock();
+    if _guard.is_some() {
+        let _ = rotate_if_over(file, cap, generations, record.len() as u64);
+    }
+    let mut f = OpenOptions::new().create(true).append(true).open(file)?;
+    f.write_all(record)?;
+    if sync {
+        f.sync_all()?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn read(p: &Path) -> String {
+        fs::read_to_string(p).unwrap_or_default()
+    }
+
+    #[test]
+    fn a_file_under_the_cap_is_left_alone() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        fs::write(&log, "12345").unwrap();
+        assert!(!rotate_if_over(&log, 5, 3, 0).unwrap());
+        assert_eq!(read(&log), "12345");
+        assert!(!generation(&log, 1).exists());
+    }
+
+    #[test]
+    fn a_missing_file_is_not_over_the_cap() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(!rotate_if_over(&dir.path().join("none.log"), 0, 3, 0).unwrap());
+    }
+
+    #[test]
+    fn a_file_over_the_cap_moves_to_generation_one() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        fs::write(&log, "123456").unwrap();
+        assert!(rotate_if_over(&log, 5, 3, 0).unwrap());
+        assert!(!log.exists());
+        assert_eq!(read(&generation(&log, 1)), "123456");
+    }
+
+    #[test]
+    fn rotation_shifts_generations_and_drops_the_oldest() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        for session in ["a", "b", "c", "d", "e"] {
+            fs::write(&log, session).unwrap();
+            rotate(&log, 3).unwrap();
+        }
+        assert_eq!(read(&generation(&log, 1)), "e");
+        assert_eq!(read(&generation(&log, 2)), "d");
+        assert_eq!(read(&generation(&log, 3)), "c");
+        assert!(!generation(&log, 4).exists());
+        assert!(!log.exists());
+    }
+
+    #[test]
+    fn rotation_with_no_generations_deletes() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        fs::write(&log, "x").unwrap();
+        rotate(&log, 0).unwrap();
+        assert!(!log.exists() && !generation(&log, 1).exists());
+    }
+
+    #[test]
+    fn an_append_over_the_cap_rotates_first_and_loses_nothing() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        for i in 0..10 {
+            append(&log, 20, 8, format!("record-{i:02}\n").as_bytes(), false).unwrap();
+        }
+        let mut all = String::new();
+        for n in (1..=8).rev() {
+            all.push_str(&read(&generation(&log, n)));
+        }
+        all.push_str(&read(&log));
+        let expect: String = (0..10).map(|i| format!("record-{i:02}\n")).collect();
+        assert_eq!(all, expect);
+        assert!(generation(&log, 1).exists(), "the cap must have rotated");
+    }
+
+    #[test]
+    fn the_record_that_triggers_rotation_lands_whole_in_the_new_live_file() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        fs::write(&log, "old old old old\n").unwrap();
+        append(&log, 4, 3, b"new record\n", false).unwrap();
+        assert_eq!(read(&log), "new record\n");
+        assert_eq!(read(&generation(&log, 1)), "old old old old\n");
+    }
+
+    #[test]
+    fn a_failed_rotation_still_writes_the_record() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        fs::write(&log, "0123456789").unwrap();
+        // A directory where `.1` should go makes the rename fail.
+        fs::create_dir(generation(&log, 1)).unwrap();
+        fs::write(generation(&log, 1).join("pin"), "x").unwrap();
+        append(&log, 4, 1, b"kept\n", true).unwrap();
+        assert!(read(&log).ends_with("kept\n"));
+    }
+
+    #[test]
+    fn concurrent_writers_never_interleave_or_lose_a_record() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = dir.path().join("crashes.log");
+        let (threads, each) = (8usize, 60usize);
+        std::thread::scope(|s| {
+            for t in 0..threads {
+                let log = &log;
+                s.spawn(move || {
+                    for i in 0..each {
+                        // Both writers' shapes: short events and longer reports.
+                        let line = if i % 2 == 0 {
+                            format!("{{\"t\":{t},\"i\":{i}}}\n")
+                        } else {
+                            format!("report t={t} i={i} {}\n", "x".repeat(80))
+                        };
+                        append(log, 512, 200, line.as_bytes(), false).unwrap();
+                    }
+                });
+            }
+        });
+        let mut lines = Vec::new();
+        for path in std::iter::once(log.clone()).chain((1..=200).map(|n| generation(&log, n))) {
+            lines.extend(read(&path).lines().map(str::to_owned));
+        }
+        assert_eq!(lines.len(), threads * each);
+        for l in &lines {
+            let whole_event = l.starts_with("{\"t\":") && l.ends_with('}');
+            let whole_report = l.starts_with("report t=") && l.ends_with(&"x".repeat(80));
+            assert!(whole_event || whole_report, "torn line: {l:?}");
+        }
+        let mut seen = std::collections::HashSet::new();
+        assert!(
+            lines.iter().all(|l| seen.insert(l.clone())),
+            "duplicate record"
+        );
+    }
+}
