+#[cfg(test)]
+mod tests {
+    use super::*;
+    const TEST: &str = "recovery::worker::tests::suspended_capture_and_hard_deadlines";
+    #[test]
+    fn suspended_capture_and_hard_deadlines() {
+        worker();
+        if let Some(root) = std::env::var_os("SCARLETT_0068_FIXTURE") {
+            let root = PathBuf::from(root);
+            let mode = std::env::var("SCARLETT_0068_MODE").unwrap();
+            let storage = root.join("storage");
+            fs::create_dir(&storage).unwrap();
+            let saves = root.join("saves");
+            fs::create_dir(&saves).unwrap();
+            fs::write(saves.join("save"), b"committed").unwrap();
+            let counter = std::sync::Arc::new(std::sync::atomic::AtomicU64::new(0));
+            let address = std::sync::Arc::as_ptr(&counter) as usize;
+            let active = counter.clone();
+            let _mutator = std::thread::spawn(move || {
+                loop {
+                    active.fetch_add(1, Ordering::Relaxed);
+                    std::thread::yield_now();
+                }
+            });
+            while counter.load(Ordering::Relaxed) < 100 {
+                std::thread::yield_now();
+            }
+            let large = if mode == "size" {
+                vec![0x68u8; 128 << 20]
+            } else {
+                Vec::new()
+            };
+            std::hint::black_box(&large);
+            unsafe {
+                std::env::set_var("SCARLETT_0068_COUNTER", address.to_string());
+            }
+            launch(Request {
+                root: root.join("recovery"),
+                saves,
+                storage,
+                log: root.join("crashes.log"),
+                reason: 0x887a0005u32 as i32,
+                commands: None,
+                dred: String::new(),
+                fault: "synthetic no-title removal".into(),
+                saves_busy: false,
+            })
+            .unwrap();
+            panic!("helper failed to terminate target");
+        }
+        for (mode, millis, code) in [
+            ("success", 10000, COMPLETE_EXIT),
+            ("size", 1000, DEADLINE_EXIT),
+            ("stall", 1000, DEADLINE_EXIT),
+            ("helper_death", 1000, DEADLINE_EXIT),
+        ] {
+            let root = tempfile::tempdir().unwrap();
+            let mut child = Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", TEST, "--nocapture"])
+                .env("SCARLETT_0068_FIXTURE", root.path())
+                .env("SCARLETT_0068_MODE", mode)
+                .env("SCARLETT_RECOVERY_TEST_ENTRY", TEST)
+                .env("VICTORY_RECOVERY_BUDGET_MS", millis.to_string())
+                .env_remove(CHILD)
+                .spawn()
+                .unwrap();
+            let started = Instant::now();
+            let status = loop {
+                match child.try_wait().unwrap() {
+                    Some(status) => break status,
+                    None if started.elapsed() < Duration::from_secs(15) => {
+                        std::thread::sleep(Duration::from_millis(10))
+                    }
+                    None => {
+                        let _ = child.kill();
+                        let _ = child.wait();
+                        panic!("worker/target hung in mode {mode}");
+                    }
+                }
+            };
+            assert_eq!(status.code().unwrap() as u32, code, "mode={mode}");
+            let folder = fs::read_dir(root.path().join("recovery"))
+                .unwrap()
+                .next()
+                .unwrap()
+                .unwrap()
+                .path();
+            if mode == "success" {
+                assert!(is_complete(&folder));
+                assert!(
+                    fs::read_to_string(folder.join("quiescence.txt"))
+                        .unwrap()
+                        .starts_with("mutator=")
+                );
+            } else {
+                assert!(!is_complete(&folder));
+                assert!(folder.join("PARTIAL").exists());
+                assert!(!folder.join("COMPLETE").exists());
+                assert!(
+                    started.elapsed() < Duration::from_millis(millis + 2000),
+                    "budget not bounded: {:?}",
+                    started.elapsed()
+                );
+            }
+            // Independently observe task-owned helper cleanup, even after target death.
+            let pid: u32 = fs::read_to_string(root.path().join("worker.pid"))
+                .unwrap()
+                .parse()
+                .unwrap();
+            let helper = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid) };
+            if !helper.is_null() {
+                let mut exit = 259;
+                let stop = Instant::now();
+                while unsafe { GetExitCodeProcess(helper, &mut exit) } != 0
+                    && exit == 259
+                    && stop.elapsed() < Duration::from_secs(2)
+                {
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+                unsafe {
+                    CloseHandle(helper);
+                }
+                assert_ne!(exit, 259, "orphan helper in {mode}");
+            }
+            eprintln!(
+                "0068 {mode}: target/helper terminated in {:?}",
+                started.elapsed()
+            );
+        }
+    }
+}
