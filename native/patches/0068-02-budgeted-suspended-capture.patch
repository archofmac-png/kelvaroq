+            .create(true)
+            .open(path("SCARLETT_RECOVERY_LOG")?)?;
+        log.write_all(line.as_bytes())?;
+        log.sync_all()
+    })();
+    if let Err(e) = report {
+        eprintln!("recovery report could not be persisted: {e}");
+    }
+    eprintln!(
+        "GPU recovery stopped ({outcome}); keep recovery folder: {}",
+        folder.display()
+    );
+    unsafe {
+        TerminateProcess(target, code);
+        TerminateProcess(GetCurrentProcess(), 0);
+    }
+    std::process::abort();
+}
+
+fn suspend_target(pid: u32, watchdog_tid: u32, budget: &Budget) -> io::Result<()> {
+    // Keep handles open to pin thread identities against tid reuse. No resume:
+    // target termination follows capture or any error/deadline.
+    let mut suspended = std::collections::HashMap::new();
+    let mut stable = 0;
+    while stable < 2 {
+        budget.check()?;
+        let snapshot = unsafe { CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0) };
+        if snapshot == INVALID_HANDLE_VALUE {
+            return Err(io::Error::last_os_error());
+        }
+        let mut entry = THREADENTRY32 {
+            dwSize: size_of::<THREADENTRY32>() as u32,
+            ..unsafe { std::mem::zeroed() }
+        };
+        let mut more = unsafe { Thread32First(snapshot, &mut entry) } != 0;
+        let mut added = false;
+        while more {
+            if entry.th32OwnerProcessID == pid
+                && entry.th32ThreadID != watchdog_tid
+                && !suspended.contains_key(&entry.th32ThreadID)
+            {
+                let thread = unsafe {
+                    OpenThread(
+                        THREAD_SUSPEND_RESUME | THREAD_QUERY_LIMITED_INFORMATION,
+                        0,
+                        entry.th32ThreadID,
+                    )
+                };
+                if thread.is_null() {
+                    unsafe {
+                        CloseHandle(snapshot);
+                    }
+                    return Err(io::Error::last_os_error());
+                }
+                let owner = unsafe { GetProcessIdOfThread(thread) };
+                if owner != pid || unsafe { SuspendThread(thread) } == u32::MAX {
+                    unsafe {
+                        CloseHandle(thread);
+                        CloseHandle(snapshot);
+                    }
+                    return Err(invalid("target thread suspension failed"));
+                }
+                suspended.insert(entry.th32ThreadID, thread);
+                added = true;
+            }
+            more = unsafe { Thread32Next(snapshot, &mut entry) } != 0;
+        }
+        let error = io::Error::last_os_error();
+        unsafe {
+            CloseHandle(snapshot);
+        }
+        if error.raw_os_error() != Some(ERROR_NO_MORE_FILES as i32) {
+            return Err(error);
+        }
+        if added {
+            stable = 0;
+        } else {
+            stable += 1;
+        }
+    }
+    // Handle closure does not resume threads.
+    for (_, thread) in suspended {
+        unsafe {
+            CloseHandle(thread);
+        }
+    }
+    Ok(())
+}
+
+fn readable_bytes(process: HANDLE, budget: &Budget) -> io::Result<u64> {
+    let mut at = 0usize;
+    let mut bytes = 0u64;
+    loop {
+        budget.check()?;
+        let mut region = MEMORY_BASIC_INFORMATION::default();
+        if unsafe { VirtualQueryEx(process, at as *const _, &mut region, size_of_val(&region)) }
+            == 0
+        {
+            let error = io::Error::last_os_error();
+            if error.raw_os_error() == Some(ERROR_INVALID_PARAMETER as i32) {
+                return Ok(bytes);
+            }
+            return Err(error);
+        }
+        if region.State == MEM_COMMIT
+            && region.Protect != 0
+            && region.Protect & PAGE_NOACCESS == 0
+            && region.Protect & 0xff != PAGE_EXECUTE
+        {
+            bytes = bytes.saturating_add(region.RegionSize as u64);
+        }
+        at = (region.BaseAddress as usize)
+            .checked_add(region.RegionSize)
+            .filter(|n| *n > at)
+            .ok_or_else(|| invalid("invalid region"))?;
+    }
+}
+fn tree_bytes(at: &Path, budget: &Budget) -> io::Result<u64> {
+    use std::os::windows::fs::MetadataExt;
+    budget.check()?;
+    let meta = match fs::symlink_metadata(at) {
+        Ok(m) => m,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(0),
+        Err(e) => return Err(e),
+    };
+    if meta.file_attributes() & 0x400 != 0 {
+        return Err(invalid("state contains a reparse point"));
+    }
+    if meta.is_file() {
+        return Ok(meta.len());
+    }
+    let mut bytes = 0u64;
+    for entry in fs::read_dir(at)? {
+        bytes = bytes.saturating_add(tree_bytes(&entry?.path(), budget)?);
+    }
+    Ok(bytes)
+}
