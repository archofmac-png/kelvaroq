+#[cfg(test)]
+fn exercise_test_faults(target: HANDLE, generation: &mut Generation) -> io::Result<()> {
+    use windows_sys::Win32::System::Diagnostics::Debug::ReadProcessMemory;
+    if let Ok(address) = number::<usize>("SCARLETT_0068_COUNTER") {
+        let read = || -> io::Result<u64> {
+            let mut value = 0u64;
+            let mut count = 0;
+            if unsafe {
+                ReadProcessMemory(
+                    target,
+                    address as *const _,
+                    (&raw mut value).cast(),
+                    8,
+                    &mut count,
+                )
+            } == 0
+                || count != 8
+            {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(value)
+        };
+        let before = read()?;
+        unsafe {
+            Sleep(30);
+        }
+        let after = read()?;
+        if before != after {
+            return Err(invalid("title mutator still executing during capture"));
+        }
+        generation.write(Path::new("quiescence.txt"), |out| {
+            writeln!(out, "mutator={before},{after}")
+        })?;
+    }
+    match std::env::var("SCARLETT_0068_MODE")
+        .unwrap_or_default()
+        .as_str()
+    {
+        "stall" => unsafe {
+            Sleep(30_000);
+        },
+        "helper_death" => unsafe {
+            TerminateProcess(GetCurrentProcess(), 99);
+        },
+        _ => {}
+    }
+    Ok(())
+}
