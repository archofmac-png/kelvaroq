+//! Out-of-process capture: target locks and heap state are never used after suspension.
+use super::*;
+use std::process::Command;
+use windows_sys::Win32::{
+    Foundation::*,
+    System::{Diagnostics::ToolHelp::*, Memory::*, Threading::*},
+};
+
+pub const DEADLINE_EXIT: u32 = 0xe0680002;
+const INCOMPLETE_EXIT: u32 = 0xe0670002;
+const COMPLETE_EXIT: u32 = 0xe0670001;
+const CHILD: &str = "SCARLETT_RECOVERY_WORKER";
+
+pub struct Request {
+    pub root: PathBuf,
+    pub saves: PathBuf,
+    pub storage: PathBuf,
+    pub log: PathBuf,
+    pub reason: i32,
+    pub commands: Option<u64>,
+    pub dred: String,
+    pub fault: String,
+    pub saves_busy: bool,
+}
+
+/// Invoked only after removal. Caller holds the save lock (or records busy),
+/// launches before suspension, then performs no more capture work in the title.
+/// Returns only on launch failure; successful helper owns target termination.
+pub fn launch(request: Request) -> io::Result<()> {
+    let millis = std::env::var("VICTORY_RECOVERY_BUDGET_MS")
+        .ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .unwrap_or(2000)
+        .clamp(50, 10_000);
+    let deadline = unsafe { windows_sys::Win32::System::SystemInformation::GetTickCount64() }
+        .saturating_add(millis);
+    // Independent fallback covers a blocked CreateProcess or helper startup.
+    // Once suspended, the helper's own watchdog replaces this one.
+    let (tx, rx) = std::sync::mpsc::sync_channel(0);
+    std::thread::Builder::new()
+        .name("recovery-start-deadline".into())
+        .spawn(move || {
+            let _ = tx.send(unsafe { GetCurrentThreadId() });
+            unsafe {
+                Sleep(millis as u32);
+            }
+            unsafe {
+                TerminateProcess(GetCurrentProcess(), DEADLINE_EXIT);
+            }
+        })?;
+    let watchdog_tid = rx
+        .recv_timeout(Duration::from_millis(millis))
+        .unwrap_or_else(|_| {
+            unsafe {
+                TerminateProcess(GetCurrentProcess(), DEADLINE_EXIT);
+            }
+            std::process::abort()
+        });
+    let parent_created = process_created(unsafe { GetCurrentProcess() })?;
+    let mut command = Command::new(std::env::current_exe()?);
+    // Test binaries reenter their selected fixture; production checks worker()
+    // before CLI parsing. No shell, no title data, no extra shipped executable.
+
+    command
+        .env(CHILD, std::process::id().to_string())
+        .env(
+            "SCARLETT_RECOVERY_PARENT_CREATED",
+            parent_created.to_string(),
+        )
+        .env("SCARLETT_RECOVERY_WATCHDOG_TID", watchdog_tid.to_string())
+        .env("SCARLETT_RECOVERY_ROOT", request.root)
+        .env("SCARLETT_RECOVERY_SAVES", request.saves)
+        .env("SCARLETT_RECOVERY_STORAGE", request.storage)
+        .env("SCARLETT_RECOVERY_LOG", request.log)
+        .env("SCARLETT_RECOVERY_DEADLINE", deadline.to_string())
+        .env("SCARLETT_RECOVERY_REASON", request.reason.to_string())
+        .env(
+            "SCARLETT_RECOVERY_COMMANDS",
+            request.commands.map_or(String::new(), |n| n.to_string()),
+        )
+        .env("SCARLETT_RECOVERY_DRED", request.dred)
+        .env("SCARLETT_RECOVERY_FAULT", request.fault)
+        .env(
+            "SCARLETT_RECOVERY_SAVES_BUSY",
+            if request.saves_busy { "1" } else { "0" },
+        );
+    // HLE test executable is not compiled with loader's cfg(test).
+    if let Some(test) = std::env::var_os("SCARLETT_RECOVERY_TEST_ENTRY") {
+        command.arg("--exact").arg(test).arg("--nocapture");
+    } else if cfg!(test) {
+        command.args(std::env::args_os().skip(1));
+    }
+    let mut child = command.spawn()?;
+    let status = child.wait()?;
+    Err(invalid(&format!(
+        "recovery worker ended before terminating target: {status}"
+    )))
+}
+
+fn env(name: &str) -> io::Result<std::ffi::OsString> {
+    std::env::var_os(name).ok_or_else(|| invalid("missing recovery worker field"))
+}
+fn number<T: std::str::FromStr>(name: &str) -> io::Result<T> {
+    env(name)?
+        .to_str()
+        .ok_or_else(|| invalid("invalid worker number"))?
+        .parse()
+        .map_err(|_| invalid("invalid worker number"))
+}
+fn path(name: &str) -> io::Result<PathBuf> {
+    Ok(PathBuf::from(env(name)?))
+}
+fn process_created(process: HANDLE) -> io::Result<u64> {
+    let mut created = FILETIME::default();
+    let mut exited = FILETIME::default();
+    let mut kernel = FILETIME::default();
+    let mut user = FILETIME::default();
+    if unsafe { GetProcessTimes(process, &mut created, &mut exited, &mut kernel, &mut user) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok((u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime))
+}
+fn parent_is(pid: u32) -> bool {
+    // Prevent an inherited/stale worker variable from targeting an unrelated pid.
+    unsafe {
+        let snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+        if snapshot == INVALID_HANDLE_VALUE {
+            return false;
+        }
+        let mut entry = PROCESSENTRY32W {
+            dwSize: size_of::<PROCESSENTRY32W>() as u32,
+            ..std::mem::zeroed()
+        };
+        let mut more = Process32FirstW(snapshot, &mut entry) != 0;
+        let mut found = false;
+        while more {
+            if entry.th32ProcessID == GetCurrentProcessId() {
+                found = entry.th32ParentProcessID == pid;
+                break;
+            }
+            more = Process32NextW(snapshot, &mut entry) != 0;
+        }
+        CloseHandle(snapshot);
+        found
+    }
+}
