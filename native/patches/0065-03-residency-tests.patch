@@ -1,5 +1,30 @@
 use super::*;
 
+#[test]
+fn a_page_written_and_reread_in_one_frame_stays_direct() {
+    let page = PAGE as usize;
+    let mut directory = [0, 0, 1, 0];
+    let mut sections = Sections::default();
+    sections.candidates.push((1, 0, 0));
+    let mut physical = vec![0u8; page];
+    for value in [17, 93] {
+        physical[256..512].fill(value);
+        let reads = sections.publish(directory.as_mut_ptr(), 1);
+        let mut copied = 0;
+        reads.fallback(page + 256, 256, |_, n| copied += n);
+        assert_eq!(copied, 0, "CPU writes do not invalidate shared backing");
+        assert_eq!(directory[2..], [COPIES + 1, 0]);
+        let offset = directory[3] as usize + 256;
+        assert_eq!(&physical[offset..offset + 256], &[value; 256]);
+    }
+    // A writer submission must restore the copied page before refreshing it.
+    let reads = sections.publish(directory.as_mut_ptr(), 0);
+    let mut copied = 0;
+    reads.fallback(page + 256, 256, |_, n| copied += n);
+    assert_eq!(copied, 256);
+    assert_eq!(directory[2..], [1, 0]);
+}
