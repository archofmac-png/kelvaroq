+    #[test]
+    #[cfg(windows)]
+    fn vram_pressure_reclaims_only_unpinned_completed_copies_and_accounts_recreation() {
+        use std::sync::atomic::Ordering::Relaxed;
+        if crate::host::host().is_none() {
+            return;
+        }
+        let null = std::ptr::null();
+        struct Images([This; 3]);
+        impl Drop for Images {
+            fn drop(&mut self) {
+                for image in self.0 {
+                    if !image.is_null() {
+                        resource_release(image);
+                    }
+                }
+            }
+        }
+        let mut images = Images([null; 3]);
+        for image in &mut images.0 {
+            assert_eq!(
+                create_committed(
+                    null, &PROPERTIES, 0, &texture(16, 16, 28, 1), 0,
+                    null.cast(), &RESOURCE_IIDS[0], image,
+                ),
+                S_OK
+            );
+            drop(host_copy(*image).unwrap());
+            resource(*image).host.used.store(1, Relaxed);
+        }
+        let owned_bytes = || -> u64 {
+            images.0.iter().map(|&image| {
+                resource(image).host.made.lock().unwrap().as_ref()
+                    .map_or(0, |(host, _)| host.bytes)
+            }).sum()
+        };
+        let get_copy = |index: usize| {
+            resource(images.0[index]).host.made.lock().unwrap()
+                .as_ref().unwrap().0.clone()
+        };
+        let bytes = get_copy(0).bytes;
+        assert!(bytes > 0);
+        assert_eq!(owned_bytes(), 3 * bytes);
+        // Each copy owns real host memory. Model a pressured upload budget
+        // with space for only two; no multi-GiB allocation is necessary.
+        let budget = 2 * bytes;
+        let registry = images.0.map(|image| image as usize).into_iter().collect();
+        let at = |frame: u64| (frame << 32) | 20;
+        let mut cold = ColdTextures::default();
+        assert_eq!(cold.reclaim(&registry, at(10), 3, 12, 6, || owned_bytes() <= budget), 0);
+        assert_eq!(cold.copies.len(), 3);
+        // Take owners after observation so reclaim must recheck both kinds:
+        // a list holds the Arc, a descriptor holds the COM resource itself.
+        let list = get_copy(1);
+        let slot = get_copy(2).texture.clone();
+        assert_eq!(cold.reclaim(&registry, at(14), 3, 13, 11, || owned_bytes() <= budget), 0);
+        assert_eq!(owned_bytes(), 3 * bytes, "the observed fence has not completed");
+        let evicted = KINDS[3].load(Relaxed);
+        assert_eq!(cold.reclaim(&registry, at(14), 3, 13, 12, || owned_bytes() <= budget), 1);
+        assert_eq!(owned_bytes(), budget);
+        assert!(resource(images.0[0]).host.made.lock().unwrap().is_none());
+        assert!(KINDS[3].load(Relaxed) >= evicted + bytes);
+        assert_eq!(cold.reclaim(&registry, at(15), 3, 14, 12, || false), 0);
+        assert_eq!(owned_bytes(), budget, "list and descriptor owners remain resident");
+        let recreated = KINDS[5].load(Relaxed);
+        drop(host_copy(images.0[0]).unwrap());
+        assert_eq!(owned_bytes(), 3 * bytes);
+        assert!(KINDS[5].load(Relaxed) >= recreated + bytes);
+        // The exact local byte total avoids races with other tests' KINDS[1]
+        // allocations. Cumulative accounting counters may also advance there.
+        drop((list, slot));
+    }
