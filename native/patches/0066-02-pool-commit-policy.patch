diff --git a/crates/victory-gpu/src/inplace/pool.rs b/crates/victory-gpu/src/inplace/pool.rs
index 6af9683..ac95e65 100644
--- a/crates/victory-gpu/src/inplace/pool.rs
+++ b/crates/victory-gpu/src/inplace/pool.rs
@@ -60,13 +60,13 @@ impl Drop for PoolCommit {
     }
 }
 
-/// Default to openable sections within the commit and opening budgets.
-/// VICTORY_UMA=0 restores reserved sections and the legacy copy path.
+/// Opt in: SEC_COMMIT charges whole slabs at allocation, ahead of use.
+/// Net cost versus reserved sections, including teardown, is unmeasured.
 pub fn uma_pool() -> bool {
     static ON: OnceLock<bool> = OnceLock::new();
     *ON.get_or_init(|| {
         std::env::var_os("VICTORY_UMA").is_none_or(|v| v != "0")
-            && std::env::var_os("VICTORY_UMA_POOL").is_none_or(|v| v != "0")
+            && std::env::var_os("VICTORY_UMA_POOL").is_some_and(|v| v == "1")
     })
 }
 
